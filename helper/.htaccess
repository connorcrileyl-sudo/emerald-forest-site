Options -Indexes
DirectoryIndex index.php
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
# The bundled new-site zip, logs and data are not for browsers.
<FilesMatch "\.(zip|json|log|lock|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
