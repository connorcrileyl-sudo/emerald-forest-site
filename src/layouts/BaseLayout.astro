---
import Lightbox from "@/components/media/Lightbox.astro";
import "@/styles/global.css";
import BaseHead from "@/components/utility/BaseHead.astro";
import SkipLink from "@/components/global/SkipLink.astro";
import Nav from "@/components/global/Nav.astro";
import Footer from "@/components/global/Footer.astro";
import BusinessSchema from "@/components/content/BusinessSchema.astro";
import Analytics from "@/components/utility/Analytics.astro";
import TodoHighlight from "@/components/utility/TodoHighlight.astro";
import ReviewHighlight from "@/components/utility/ReviewHighlight.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
};

const { theme = "dark", overlap = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en" class:list={[theme !== "inherit" && `theme-${theme}`]}>
  <head>
    <BaseHead {...seo} />
    <BusinessSchema />
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <defs>
        <linearGradient id="gold-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#dba743" />
          <stop offset=".3" stop-color="#c89231" />
          <stop offset=".62" stop-color="#a87824" />
          <stop offset=".84" stop-color="#bd8d38" />
          <stop offset="1" stop-color="#926722" />
        </linearGradient>
      </defs>
    </svg>
    <SkipLink />
    <Nav overlap={overlap} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Lightbox />
    <Footer />
    <TodoHighlight />
    <ReviewHighlight />
  </body>
</html>
