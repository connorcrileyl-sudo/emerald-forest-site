---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

interface Props extends HTMLAttributes<"form"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Form name. */
  name?: string;
  /** Form endpoint. Omit to skip submission. */
  action?: string;
  /** Heading shown after submission. */
  successTitle?: string;
  /** Message shown after submission. */
  successMessage?: string;
  /** Message shown after an error. */
  errorMessage?: string;
}

const {
  render = true,
  name,
  action,
  successTitle = "Message sent",
  successMessage = "Thanks for getting in touch. We'll get back to you soon.",
  errorMessage = "That did not send. Please try again.",
  method = "post",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{render && name && content && (
  <div
    class:list={["form_wrap", className]}
    data-state="idle"
    data-endpoint={action}
  >
    <form
      class="form_fields"
      name={name}
      action={action}
      method={method}
      {...rest}
    >
      <Fragment set:html={content} />
    </form>

    <div class="form_note form_note-sent" role="status" tabindex="-1">
      <span class="form_check" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none"
          stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
          stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
      </span>
      <p class="form_note-title text-style-h4">{successTitle}</p>
      <p class="text-style-main">{successMessage}</p>
    </div>
    <p class="form_note form_note-failed text-style-main" role="alert">
      {errorMessage}
    </p>
  </div>
)}

<script>
  for (const form of document.querySelectorAll<HTMLElement>(".form_wrap")) {
    const fields = form.querySelector<HTMLFormElement>(".form_fields");
    if (!fields) continue;

    const submit = fields.querySelector<HTMLButtonElement | HTMLInputElement>(
      'button:not([type]), button[type="submit"], input[type="submit"]',
    );

    fields.addEventListener("submit", async (event) => {
      const endpoint = form.dataset.endpoint;

      if (!fields.checkValidity()) return;

      event.preventDefault();
      form.dataset.state = "sending";
      if (submit) submit.disabled = true;

      try {
        if (endpoint) {
          const answer = await fetch(endpoint, {
            method: fields.method || "post",
            body: new FormData(fields),
            headers: { Accept: "application/json" },
          });
          if (!answer.ok) throw new Error(String(answer.status));
          // Form services such as Web3Forms report failure in the body.
          const data = await answer.json().catch(() => null);
          if (data && data.success === false) throw new Error("rejected");
        }
        form.dataset.state = "sent";
        fields.reset();
        form.querySelector<HTMLElement>(".form_note-sent")?.focus();
      } catch {
        form.dataset.state = "failed";
        if (submit) submit.disabled = false;
      }
    });
  }
</script>

<style is:global>
  @layer components {
    .form_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      width: 100%;
    }

    .form_fields {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      row-gap: var(--space-8);
      column-gap: var(--space-8);
    }

    .form_note {
      display: none;
      padding: var(--space-4) var(--space-5);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-small);
    }

    .form_wrap[data-state="sent"] {
      & .form_fields {
        display: none;
      }
      & .form_note-sent {
        display: flex;
      }
    }

    .form_note-sent {
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-8) var(--space-6);
      text-align: center;
      background: var(--background-2);
      border-color: var(--heading-accent);
      outline: none;

      & p {
        margin: 0;
        max-width: 40ch;
      }
    }

    .form_check {
      display: grid;
      place-items: center;
      width: 3.5rem;
      height: 3.5rem;
      margin-bottom: var(--space-2);
      border-radius: 50%;
      background: var(--button-background);
      color: var(--button-text);
      animation: form-pop 0.4s ease-out both;
    }

    .form_note-title {
      color: var(--heading-text);
    }

    @keyframes form-pop {
      from { transform: scale(0.6); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    @media (prefers-reduced-motion: reduce) {
      .form_check { animation: none; }
    }

    .form_wrap[data-state="failed"] .form_note-failed {
      display: block;
      color: var(--text);
    }
  }
</style>
