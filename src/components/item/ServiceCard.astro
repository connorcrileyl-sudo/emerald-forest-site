---
/*
 * A service card that is one big link to its page: photo, title, a line
 * of text, and an arrow label at the foot. Quiet by default (raised
 * surface, hairline border); on hover the border warms to gold, the
 * photo eases in and the arrow slides right.
 */
import Img from "@/components/media/Img.astro";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/arrow-full.svg";

interface Props {
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  heading: string;
  headingTag?: "h2" | "h3" | "h4";
  text: string;
  /** Optional short list, shown with small gold diamond bullets. */
  items?: string[];
  /** Text beside the arrow, e.g. "Staircases". */
  label: string;
}

const {
  href,
  image,
  imageAlt,
  heading,
  headingTag: Tag = "h3",
  text,
  items = [],
  label,
} = Astro.props;

/* The card is one link, so without this its name would be the photo
   alt, heading, text, list and label run together. The heading alone
   names it; the rest is read as its description. */
const id = `service-card-${href.replace(/[^a-z0-9]+/gi, "-").replace(/^-|-$/g, "") || "home"}-${Math.random().toString(36).slice(2, 7)}`;
---

<a class="service-card" href={href} aria-labelledby={`${id}-h`} aria-describedby={`${id}-t`}>
  <div class="service-card_visual">
    <Img src={image} alt={imageAlt} />
    <span class="service-card_hint" aria-hidden="true">
      <span class="service-card_hint-text">
        Click to learn more
        <Icon src={arrow} variant="small" class="service-card_hint-arrow" />
      </span>
    </span>
  </div>
  <div class="service-card_body">
    <Tag class="service-card_heading" id={`${id}-h`}>{heading}</Tag>
    <p class="service-card_text" id={`${id}-t`}>{text}</p>
    {items.length > 0 && (
      <ul class="service-card_list">
        {items.map((item) => <li>{item}</li>)}
      </ul>
    )}
    <span class="service-card_more">
      {label}
      <Icon src={arrow} variant="small" class="service-card_arrow" />
    </span>
  </div>
</a>

<style is:global>
  @layer components {
    .service-card {
      display: flex;
      flex-direction: column;
      height: 100%;
      color: var(--text);
      text-decoration: none;
      background-color: var(--dark-800);
      /* A faint gold frame that sits out past the photo, like a mat. */
      padding: var(--space-4);
      border: calc(var(--border-width) * 2) solid
        color-mix(in lab, var(--heading-text, #d39d36) 32%, transparent);
      border-radius: 0.75rem;
      overflow: hidden;
      transition: border-color var(--hover-duration) var(--hover-ease);

      @media (hover: hover) {
        &:hover {
          border-color: color-mix(in lab, var(--hover-gold, #f0b950) 70%, transparent);
          & .service-card_visual img {
            transform: scale(1.03);
            filter: grayscale(0.7) brightness(0.9);
          }
          & .service-card_hint {
            opacity: 1;
          }
          & .service-card_hint-arrow {
            transform: translateX(0.3em);
          }
          & .service-card_more {
            color: var(--hover-gold, var(--text));
          }
          & .service-card_arrow {
            transform: translateX(0.3em);
          }
        }
      }
      &:focus-visible {
        outline-offset: var(--focus-offset-outer, 2px);
      }
    }

    .service-card_visual {
      position: relative;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      border-radius: 0.375rem;
      & img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s var(--hover-ease), filter var(--hover-duration) var(--hover-ease);
      }
    }

    /* Hover: the same dark emerald wash and pill as photos that open
       full screen, but saying where the card goes. */
    .service-card_hint {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: grid;
      place-items: center;
      background: rgb(8 40 28 / 0.62);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--hover-duration) var(--hover-ease);
    }
    .service-card_hint-text {
      display: inline-flex;
      align-items: center;
      gap: 0.6em;
      padding: 0.45rem 0.9rem;
      border: var(--border-width) solid rgb(210 154 60 / 0.6);
      background: rgb(5 26 18 / 0.85);
      color: var(--light-100);
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
      letter-spacing: 0.04em;
    }
    .service-card_hint-arrow {
      width: 1.4em;
      height: auto;
      transition: transform var(--hover-duration) var(--hover-ease);
    }

    .service-card_body {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding: var(--space-6) var(--space-2) var(--space-2);
    }

    .service-card_heading {
      font-family: var(--heading-family);
      font-weight: var(--heading-weight);
      font-size: var(--h5);
      line-height: 1.2;
      color: var(--heading-text, var(--text));
      text-wrap: balance;
      /* The subtler lit gold used for h3 and smaller headings. */
      background-image: var(--heading-fill-soft, none);
      background-size: 100% 1lh;
      background-origin: content-box;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: var(--heading-fill-text, currentcolor);
      filter: var(--heading-shadow-soft, none);
      padding-block: 0.15em 0.3em;
      margin-block: -0.15em -0.3em;
    }

    .service-card_text {
      color: var(--text-2);
      font-size: var(--text-small);
    }

    .service-card_list {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      font-size: var(--text-small);
      color: color-mix(in lab, var(--text) 84%, transparent);
      & li {
        display: flex;
        align-items: baseline;
        gap: 0.65em;
      }
      /* A small gold diamond, nudged to sit on the text's middle. */
      & li::before {
        content: "";
        flex: none;
        width: 0.38em;
        height: 0.38em;
        background-color: var(--heading-text, currentcolor);
        rotate: 45deg;
        translate: 0 -0.12em;
      }
    }

    /* Pushed to the foot so arrows line up across a row of cards. */
    .service-card_more {
      margin-top: auto;
      padding-top: var(--space-3);
      display: inline-flex;
      align-items: center;
      gap: 0.6em;
      font-size: 0.75rem;
      font-weight: var(--primary-bold);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: color-mix(in lab, var(--text) 60%, transparent);
      transition: color var(--hover-duration) var(--hover-ease);
    }

    .service-card_arrow {
      width: 1.6em;
      height: auto;
      transition: transform var(--hover-duration) var(--hover-ease);
    }
  }
</style>
