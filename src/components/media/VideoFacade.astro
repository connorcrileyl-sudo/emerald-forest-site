---
/**
 * A Facebook reel shown as a still photo with a play button. The
 * Facebook player (and its tracking scripts) only loads when someone
 * clicks play, so the page stays fast and nothing from Facebook loads
 * for visitors who never press it.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** Public URL of the reel, e.g. https://www.facebook.com/reel/123/ */
  reel: string;
  /** Still image shown before playing, at its own shape. Once played,
   *  the frame switches to the vertical Facebook player. */
  poster: ImageMetadata;
  /** Video title, used for the play button label and the player. */
  title: string;
  /** Utility classes. */
  class?: string;
}

const { reel, poster, title, class: className } = Astro.props;

const player =
  "https://www.facebook.com/plugins/video.php?height=476&width=267&show_text=false&autoplay=true&href=" +
  encodeURIComponent(reel);
---

<figure class:list={["video-facade", className]}>
  <div class="video-facade_frame" data-player={player} data-title={title} style={`aspect-ratio: ${poster.width} / ${poster.height}`}>
    <button type="button" class="video-facade_button" aria-label={`Play video: ${title}`}>
      <Image src={poster} alt="" widths={[480, 720, 1200]} sizes="(min-width: 48rem) 30rem, 100vw" class="video-facade_poster" />
      <span class="video-facade_play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="40" height="40"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
      </span>
    </button>
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLElement>(".video-facade_frame").forEach((frame) => {
    frame.querySelector("button")?.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = frame.dataset.player ?? "";
      iframe.title = frame.dataset.title ?? "Video";
      iframe.allow =
        "autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      frame.classList.add("is-playing");
      frame.replaceChildren(iframe);
    }, { once: true });
  });
</script>

<style is:global>
  @layer components {
    .video-facade {
      width: 100%;
      max-width: 30rem;
      margin: 0;
    }

    /* Same 267 x 476 shape as the Facebook player, so nothing jumps
       when it swaps in. */
    .video-facade_frame {
      background: #000;
      border: var(--border-width) solid rgb(210 154 60 / 0.3);
      overflow: hidden;
    }

    /* Playing: the Facebook player's own 267 x 476 shape. */
    .video-facade_frame.is-playing {
      aspect-ratio: 267 / 476 !important;
      max-width: 16rem;
      margin-inline: auto;
    }

    .video-facade_frame iframe {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .video-facade_button {
      position: relative;
      display: block;
      width: 100%;
      height: 100%;
      padding: 0;
      border: 0;
      background: #000;
      color: var(--light-100);
      cursor: pointer;
    }

    .video-facade_poster {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: opacity var(--hover-duration) var(--hover-ease);
    }

    .video-facade_button:hover .video-facade_poster {
      opacity: 0.85;
    }

    .video-facade_play {
      position: absolute;
      inset: 50% auto auto 50%;
      display: grid;
      place-items: center;
      width: 5.5rem;
      height: 5.5rem;
      translate: -50% -50%;
      border-radius: var(--radius-round);
      background: var(--brand-500);
      color: var(--brand-text);
      box-shadow: 0 0.25rem 1rem rgb(0 0 0 / 0.5);
      transition: scale var(--hover-duration) var(--hover-ease);
    }

    .video-facade_button:hover .video-facade_play,
    .video-facade_button:focus-visible .video-facade_play {
      scale: 1.08;
    }
  }
</style>
