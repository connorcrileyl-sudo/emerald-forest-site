---
/**
 * Full-screen photo viewer for a page. Any button with `data-lightbox`
 * opens it, showing the image in its `data-full` attribute (alt text in
 * `data-alt`). Arrows, arrow keys and swipes step through every such
 * button on the page in order; Esc, the X or the backdrop closes it.
 *
 * Also styles <ZoomBadge /> (put one inside each lightbox button): on
 * hover the photo greys out with "Click to view fullscreen", and touch
 * screens get a small corner icon instead.
 */
---

<dialog class="lightbox" aria-label="Photo viewer">
  <img class="lightbox_img" alt="" />
  <button type="button" class="lightbox_btn is-close" aria-label="Close">
    <svg viewBox="0 0 24 24" width="24" height="24"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
  </button>
  <button type="button" class="lightbox_btn is-prev" aria-label="Previous photo">
    <svg viewBox="0 0 24 24" width="24" height="24"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <button type="button" class="lightbox_btn is-next" aria-label="Next photo">
    <svg viewBox="0 0 24 24" width="24" height="24"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
</dialog>

<script>
  const viewer = document.querySelector<HTMLDialogElement>(".lightbox");
  const img = viewer?.querySelector<HTMLImageElement>(".lightbox_img");
  const items = [...document.querySelectorAll<HTMLButtonElement>("[data-lightbox]")];
  let current = 0;

  const show = (i: number) => {
    if (!img || !items.length) return;
    current = (i + items.length) % items.length;
    img.src = items[current].dataset.full ?? "";
    img.alt = items[current].dataset.alt ?? "";
  };

  items.forEach((item, i) =>
    item.addEventListener("click", () => {
      show(i);
      viewer?.showModal();
    }),
  );
  viewer?.querySelector(".is-close")?.addEventListener("click", () => viewer.close());
  viewer?.querySelector(".is-prev")?.addEventListener("click", () => show(current - 1));
  viewer?.querySelector(".is-next")?.addEventListener("click", () => show(current + 1));
  /* Click the dark area (not the photo) to close. */
  viewer?.addEventListener("click", (e) => {
    if (e.target === viewer) viewer.close();
  });
  viewer?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") show(current - 1);
    if (e.key === "ArrowRight") show(current + 1);
  });
  /* Swipe left/right on phones. */
  let startX = 0;
  viewer?.addEventListener("touchstart", (e) => (startX = e.touches[0].clientX), { passive: true });
  viewer?.addEventListener("touchend", (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
  });
  /* Return focus to the photo that was opened. */
  viewer?.addEventListener("close", () => items[current]?.focus());
</script>

<style is:global>
  [data-lightbox] {
    position: relative;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }
  [data-lightbox]:focus-visible {
    outline: var(--focus-width) solid var(--brand-300);
    outline-offset: 2px;
  }

  /* Hover: grey the photo out and say what a click does. */
  .zoom-hint {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    padding: var(--space-3);
    background: rgb(20 22 20 / 0.6);
    color: var(--light-100);
    font-size: var(--text-small);
    font-weight: var(--primary-medium);
    letter-spacing: 0.04em;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--hover-duration) var(--hover-ease);
  }
  .zoom-hint_text {
    padding: 0.45rem 0.9rem;
    border: var(--border-width) solid rgb(210 154 60 / 0.6);
    background: rgb(6 9 7 / 0.75);
  }
  /* The before/after image has its arrow badge in the middle. */
  .before-after .zoom-hint {
    align-items: start;
    padding-top: 12%;
  }
  [data-lightbox]:hover .zoom-hint,
  [data-lightbox]:focus-visible .zoom-hint {
    opacity: 1;
  }
  [data-lightbox]:hover img,
  [data-lightbox]:focus-visible img {
    filter: grayscale(1);
  }
  [data-lightbox] img {
    transition: filter var(--hover-duration) var(--hover-ease);
  }

  /* Touch screens can't hover, so they get a small corner icon. */
  .zoom-badge {
    display: none;
  }
  @media (hover: none) {
    .zoom-hint {
      display: none;
    }
    .zoom-badge {
      display: grid;
    }
  }
  .zoom-badge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 1;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-round);
    background: rgb(6 9 7 / 0.7);
    color: var(--light-100);
    pointer-events: none;
  }

  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(4 6 5 / 0.95);
    &::backdrop {
      background: rgb(0 0 0 / 0.6);
    }
    &[open] {
      display: grid;
      place-items: center;
    }
  }
  .lightbox_img {
    max-width: calc(100vw - 8rem);
    max-height: calc(100dvh - 4rem);
    object-fit: contain;
    @media (width < 48rem) {
      max-width: 100vw;
      max-height: calc(100dvh - 8rem);
    }
  }
  .lightbox_btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: var(--border-width) solid rgb(210 154 60 / 0.5);
    border-radius: var(--radius-round);
    background: rgb(6 9 7 / 0.8);
    color: var(--brand-300);
    cursor: pointer;
    &:hover {
      background: var(--brand-500);
      color: var(--brand-text);
    }
    &.is-close { top: 1rem; right: 1rem; }
    &.is-prev { left: 1rem; top: 50%; translate: 0 -50%; }
    &.is-next { right: 1rem; top: 50%; translate: 0 -50%; }
    @media (width < 48rem) {
      &.is-prev, &.is-next { top: auto; bottom: 1rem; translate: none; }
    }
  }
</style>
