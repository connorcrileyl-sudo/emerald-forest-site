---
/**
 * Marks a photo as opening full screen. Put it inside a `data-lightbox`
 * button; <Lightbox /> styles it. On hover the photo greys out with
 * "Click to view fullscreen"; touch screens (no hover) get a small
 * expand icon in the corner instead.
 */
---

<span class="zoom-hint" aria-hidden="true">
  <span class="zoom-hint_text">Click to view fullscreen</span>
</span>
<span class="zoom-badge" aria-hidden="true">
  <svg viewBox="0 0 24 24" width="16" height="16"><path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
</span>
