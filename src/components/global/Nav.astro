---
import NavLink from "@/components/global/NavLink.astro";
import Button from "@/components/Button.astro";
/* As a file, not inlined: the logo is 75 KB of paths, so inlining it
   in the nav and footer added ~50 KB to every page. As an <img> it
   downloads once and is cached for the whole site. */
import logoUrl from "@/assets/logo/logo.svg?url";
import { SITE_NAME, NAV_LINKS, NAV_CTA } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;

/** A dropdown parent is marked when the current page is one of its links. */
const trim = (path: string) => path.replace(/\/+$/, "");
const here = trim(Astro.url.pathname);
const inGroup = (children: { href: string }[]) =>
  children.some((child) => trim(child.href) === here);
---

{render && (
  <header class:list={["nav_wrap", overlap && "overlap"]}>
    <div class="nav_inner">
      <a class="nav_logo" href="/" aria-label={SITE_NAME}>
        <img class="logo_img" src={logoUrl} alt="" width="300" height="300" decoding="async" fetchpriority="high" />
      </a>
      <button
        class="nav_toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="nav_toggle_icon" />
      </button>
      <nav class="nav_menu" id="nav-menu" aria-label="Main">
        <div class="nav_menu_inner">
          <ul class="nav_links">
            {NAV_LINKS.map((link, i) =>
              link.children ? (
                <li class="nav_group">
                  <button
                    class="nav_link nav_group_toggle"
                    type="button"
                    aria-expanded="false"
                    aria-controls={`nav-sub-${i}`}
                    data-current={inGroup(link.children) ? "true" : undefined}
                  >
                    {link.label}
                    <svg class="nav_group_chevron" viewBox="0 0 12 12" aria-hidden="true">
                      <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  </button>
                  <ul class="nav_sub" id={`nav-sub-${i}`}>
                    {link.children.map((child) => (
                      <NavLink href={child.href}>{child.label}</NavLink>
                    ))}
                  </ul>
                </li>
              ) : (
                <NavLink href={link.href}>{link.label}</NavLink>
              ),
            )}
            {NAV_CTA && (
              <li class="nav_cta">
                <Button element="link" href={NAV_CTA.href}>
                  {NAV_CTA.label}
                </Button>
              </li>
            )}
          </ul>
        </div>
      </nav>
    </div>
  </header>
)}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
    .nav_group:not(.open) > .nav_sub {
      display: grid;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const desktop = window.matchMedia("(width >= 64rem)");
    /* While the phone menu is open, everything behind it is inert so
       Tab can't wander into the hidden page. */
    const behind = () =>
      Array.from(document.body.children).filter(
        (el) => el !== nav && !el.contains(nav) && el.tagName !== "SCRIPT",
      ) as HTMLElement[];
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
      const lock = open && !desktop.matches;
      behind().forEach((el) => (el.inert = lock));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    const groups = nav.querySelectorAll<HTMLElement>(".nav_group");
    /* On desktop the dropdown also shows on hover and keyboard focus
       (CSS), so aria-expanded follows what is actually visible, and
       Escape hides it even while hovered ("dismissed" until the
       pointer or focus leaves). */
    const shown = (group: HTMLElement) =>
      !group.classList.contains("dismissed") &&
      (group.classList.contains("open") ||
        (desktop.matches &&
          (group.matches(":hover") || group.contains(document.activeElement))));
    const sync = (group: HTMLElement) => {
      group
        .querySelector(".nav_group_toggle")
        ?.setAttribute("aria-expanded", String(shown(group)));
    };
    const setGroup = (group: HTMLElement, open: boolean) => {
      group.classList.toggle("open", open);
      if (open) group.classList.remove("dismissed");
      sync(group);
    };
    groups.forEach((group) => {
      group
        .querySelector(".nav_group_toggle")
        ?.addEventListener("click", () => {
          const next = !shown(group);
          if (!next) group.classList.add("dismissed");
          setGroup(group, next);
        });
      group.addEventListener("mouseenter", () => sync(group));
      group.addEventListener("mouseleave", () => {
        group.classList.remove("dismissed");
        sync(group);
      });
      group.addEventListener("focusin", () => sync(group));
      group.addEventListener("focusout", (event) => {
        if (!group.contains(event.relatedTarget as Node | null)) {
          group.classList.remove("dismissed");
          if (desktop.matches) setGroup(group, false);
          else sync(group);
        }
      });
    });
    document.addEventListener("click", (event) => {
      groups.forEach((group) => {
        if (event.target instanceof Node && !group.contains(event.target)) {
          setGroup(group, false);
        }
      });
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        groups.forEach((group) => {
          if (shown(group)) {
            group.classList.add("dismissed");
            setGroup(group, false);
            group.querySelector<HTMLElement>(".nav_group_toggle")?.focus();
          }
        });
      }
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    desktop.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
      groups.forEach(sync);
    });
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      /* Emerald Forest: not sticky, no bar of its own; it scrolls away with
         the page and reads as part of the hero. */
      position: absolute;
      inset-inline: 0;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: transparent;
      color: var(--text);

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 var(--space-6);
    }

    /* Bar height */
    .nav_logo,
    .nav_toggle {
      min-height: var(--nav-height);
    }

    .logo_img {
      display: block;
      width: 100%;
      height: auto;
    }

    .nav_logo {
      display: flex;
      align-items: center;
      width: var(--logo-width-nav);
      transition: filter var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          filter: brightness(1.2) saturate(1.1);
        }
      }
    }

    .nav_toggle {
      --_icon-width: 1.5rem;
      --_bar-gap: 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      margin-right: calc((2.75rem - var(--_icon-width)) / -2);
      color: inherit;
      border-radius: var(--radius-small);
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--hover-gold, currentcolor);
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      border-bottom: var(--border-width) solid var(--border);
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
      overflow-y: auto;
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding: var(--space-2) var(--site-margin) var(--space-4);
      font-size: var(--text-main);
      font-weight: var(--primary-medium);
      & > li + li {
        border-top: var(--border-width) solid var(--border);
      }
    }

    .nav_cta {
      padding-top: var(--space-4);
    }

    /* Dropdown group. On phones it is a heading with its links listed
       underneath; from 1024px it opens on hover, focus or click. */
    .nav_link.nav_group_toggle {
      display: flex;
      align-items: center;
      gap: 0.35em;
      width: 100%;
      font: inherit;
      text-align: left;
      color: var(--text-2);
      background: none;
      border: 0;
      cursor: pointer;
      &[data-current] {
        color: var(--text);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--hover-gold, var(--text));
        }
      }
    }

    .nav_group_chevron {
      width: 0.75em;
      height: 0.75em;
      transition: transform var(--hover-duration) var(--hover-ease);
    }

    .nav_sub {
      padding-left: var(--space-4);
      padding-bottom: var(--space-2);
      & .nav_link {
        padding-block: var(--space-2);
      }
    }

    /* Phones and tablets: Services starts closed so About, Contact and
       the call button stay on screen; tapping it opens the links in
       two columns. The noscript block keeps it open without JS. */
    @media (width < 64rem) {
      .nav_sub {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: var(--space-4);
      }
      .nav_group:not(.open) > .nav_sub {
        display: none;
      }
      .nav_group.open .nav_group_chevron {
        transform: rotate(180deg);
      }
    }

    .nav_link {
      display: block;
      padding-block: var(--space-3);
      color: var(--text-2);
      text-decoration: none;
      text-underline-offset: 0.4em;
      /* Gold underline on the current page, a touch heavier than a hairline. */
      text-decoration-thickness: 2.5px;
      text-decoration-color: color-mix(in srgb, var(--brand-300) 65%, transparent);
      transition: color var(--hover-duration) var(--hover-ease);
      &[aria-current="page"] {
        color: var(--text);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--hover-gold, var(--text));
        }
      }
    }

    @media (width >= 64rem) {
      .nav_toggle {
        display: none;
      }

      /* A touch bigger than on phones. */
      .nav_logo {
        width: calc(var(--logo-width-nav) * 1.2);
      }

      .nav_menu {
        position: static;
        display: block;
        visibility: visible;
        max-height: none;
        overflow: visible;
        background-color: transparent;
        border-bottom: 0;
      }

      .nav_menu_inner {
        overflow: visible;
        opacity: 1;
      }

      .nav_links {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        padding: 0;
        gap: var(--space-6);
        font-size: var(--text-main);
        & > li + li {
          border-top: 0;
        }
      }

      .nav_cta {
        padding-top: 0;
      }

      /* Current page: a gold underline, shaded like the headings' lit
         metal (brighter in the middle, deeper at the ends). Drawn as a
         pseudo-element because text-decoration can't take a gradient. */
      .nav_link {
        position: relative;
        padding-block: 0;
        &[aria-current="page"]::after,
        &.nav_group_toggle[data-current]::after {
          content: "";
          position: absolute;
          left: 0;
          right: 0;
          bottom: -0.15em;
          height: 2.5px;
          border-radius: 2px;
          background: linear-gradient(
            90deg,
            #c08c33 0%,
            #d29a3c 50%,
            #c08c33 100%
          );
          opacity: 0.75;
          pointer-events: none;
        }
        /* The Services toggle: under the word, not the chevron. */
        &.nav_group_toggle[data-current]::after {
          right: calc(0.75em + 0.35em);
        }
      }

      .nav_group {
        position: relative;
      }

      .nav_link.nav_group_toggle {
        width: auto;
      }

      .nav_group_chevron {
        display: block;
      }

      /* Hidden until hover, keyboard focus or a click opens it. The top
         padding bridges the gap so the pointer can travel down to it. */
      .nav_sub {
        position: absolute;
        top: 100%;
        left: calc(var(--space-4) * -1);
        z-index: 10;
        min-width: 13rem;
        padding: var(--space-3) 0 0;
        visibility: hidden;
        opacity: 0;
        transform: translateY(-0.25rem);
        transition:
          opacity var(--hover-duration) var(--hover-ease),
          transform var(--hover-duration) var(--hover-ease),
          visibility var(--hover-duration) var(--hover-ease);

        &::before {
          content: "";
          position: absolute;
          inset: var(--space-3) 0 0;
          z-index: -1;
          background-color: var(--background-2);
          border: var(--border-width) solid var(--border);
          border-radius: var(--radius-small);
        }

        & > li:first-child {
          padding-top: var(--space-2);
        }

        & > li:last-child {
          padding-bottom: var(--space-2);
        }

        & .nav_link {
          padding: var(--space-2) var(--space-4);
          white-space: nowrap;
        }
      }

      .nav_group:is(:hover, :focus-within, .open):not(.dismissed) {
        & .nav_sub {
          visibility: visible;
          opacity: 1;
          transform: none;
        }
        & .nav_group_chevron {
          transform: rotate(180deg);
        }
      }
    }
  }
</style>
