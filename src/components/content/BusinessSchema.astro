---
/*
 * LocalBusiness structured data for every page. Service-area business:
 * no street address, towns served listed as areaServed, linked to the
 * Google Business Profile.
 */
import {
  SITE_NAME,
  SITE_URL,
  SITE_DESCRIPTION,
  BUSINESS,
  TOWNS,
  GOOGLE_PROFILE_URL,
  SOCIAL_LINKS,
} from "@/consts.ts";

const schema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": `${SITE_URL}/#business`,
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  url: `${SITE_URL}/`,
  telephone: "+1-828-424-5401",
  ...(BUSINESS.email ? { email: BUSINESS.email } : {}),
  image: `${SITE_URL}/og-image.jpg`,
  logo: `${SITE_URL}/favicon.svg`,
  founder: { "@type": "Person", name: "Noah" },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Black Mountain",
    addressRegion: "NC",
    postalCode: "28711",
    addressCountry: "US",
  },
  areaServed: TOWNS.map((town) => ({
    "@type": "City",
    name: `${town}, NC`,
  })),
  hasMap: GOOGLE_PROFILE_URL,
  sameAs: [GOOGLE_PROFILE_URL, ...SOCIAL_LINKS.map((link) => link.href)],
  makesOffer: [
    "Custom staircases",
    "Spiral staircases",
    "Stair railings and newel posts",
    "Solid hardwood doors",
    "Sliding barn doors",
    "Custom cabinets",
    "Kitchen cabinets",
    "Built-ins and bookshelves",
    "Floating shelves",
    "Fireplace mantels",
    "Bespoke furniture",
    "Live edge tables",
    "Finish carpentry",
    "Trim carpentry and wainscoting",
    "Crown molding installation",
    "Coffered ceilings",
    "Interior door installation",
    "Porch repair",
    "Stair repair",
    "Pergolas and outdoor structures",
    "Deck building",
    "Deck repair and staining",
    "Wood rot repair",
    "Historic home restoration",
  ].map((name) => ({
    "@type": "Offer",
    itemOffered: { "@type": "Service", name },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
