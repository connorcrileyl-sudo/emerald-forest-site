---
/*
 * LocalBusiness structured data for every page. Service-area business:
 * no street address, towns served listed as areaServed, linked to the
 * Google Business Profile.
 */
import {
  SITE_NAME,
  SITE_URL,
  SITE_DESCRIPTION,
  BUSINESS,
  TOWNS,
  GOOGLE_PROFILE_URL,
  SOCIAL_LINKS,
} from "@/consts.ts";

const schema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": `${SITE_URL}/#business`,
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  url: `${SITE_URL}/`,
  /* "(828) 424-5401" -> "+1-828-424-5401" */
  telephone: `+1-${BUSINESS.phone.replace(/\D/g, "").replace(/(\d{3})(\d{3})(\d{4})/, "$1-$2-$3")}`,
  ...(BUSINESS.email ? { email: BUSINESS.email } : {}),
  image: `${SITE_URL}/og-image.jpg`,
  logo: `${SITE_URL}/favicon.svg`,
  founder: { "@type": "Person", name: "Noah" },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Black Mountain",
    addressRegion: "NC",
    postalCode: "28711",
    addressCountry: "US",
  },
  geo: { "@type": "GeoCoordinates", latitude: 35.6179, longitude: -82.3212 },
  /* The towns by name, plus the 50-mile radius the home page map shows. */
  areaServed: [
    ...TOWNS.map((town) => ({ "@type": "City", name: `${town}, NC` })),
    {
      "@type": "GeoCircle",
      geoMidpoint: { "@type": "GeoCoordinates", latitude: 35.6179, longitude: -82.3212 },
      geoRadius: "80467",
    },
  ],
  hasMap: GOOGLE_PROFILE_URL,
  sameAs: [GOOGLE_PROFILE_URL, ...SOCIAL_LINKS.map((link) => link.href)],
  makesOffer: [
    "Custom staircases",
    "Spiral staircases",
    "Stair railings and newel posts",
    "Solid hardwood doors",
    "Sliding barn doors",
    "Custom cabinets",
    "Custom kitchens",
    "Kitchen cabinets",
    "Wood countertops",
    "Built-ins and bookshelves",
    "Floating shelves",
    "Fireplace mantels",
    "Custom furniture",
    "Live edge tables",
    "Finish carpentry",
    "Trim carpentry and wainscoting",
    "Crown molding installation",
    "Coffered ceilings",
    "Interior door installation",
    "Stair repair",
    "Pergolas and outdoor structures",
  ].map((name) => ({
    "@type": "Offer",
    itemOffered: { "@type": "Service", name },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
