---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"figure"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The customer's words, without quotation marks. */
  quote?: string;
  /** Who said it. */
  name?: string;
  /** Role, company or town, e.g. "Homeowner, Springfield". */
  detail?: string;
  /** Star rating out of 5, shown as gold stars. Only the review's real rating. */
  rating?: 1 | 2 | 3 | 4 | 5;
  /** Color theme of element and its children. */
  theme?: "inherit" | "light" | "dark" | "brand" | "invert";
};

const {
  render = true,
  quote,
  name,
  detail,
  rating,
  theme = "inherit",
  class: className,
  ...rest
} = Astro.props;
---

{render && quote && name && (
  <figure
    class:list={[
      "quote-card_wrap",
      theme !== "inherit" && `theme-${theme}`,
      className,
    ]}
    {...rest}
  >
    {rating && (
      <div class="quote-card_stars" role="img" aria-label={`${rating} out of 5 stars`}>
        {Array.from({ length: 5 }, (_, i) => (
          <svg viewBox="0 0 24 24" aria-hidden="true" class:list={[i >= rating && "is-empty"]}>
            <path d="M12 2.6l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.4l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" />
          </svg>
        ))}
      </div>
    )}
    <blockquote class="quote-card_quote text-style-large">
      <p>{quote}</p>
    </blockquote>
    <figcaption class="quote-card_caption">
      <span class="quote-card_name">{name}</span>
      {detail && (
        <span class="quote-card_detail text-style-small">{detail}</span>
      )}
    </figcaption>
  </figure>
)}

<style is:global>
  @layer components {
    .quote-card_wrap {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: var(--space-6);
      padding: var(--space-6);
      background-color: var(--background-3);
      color: var(--text);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
    }

    .quote-card_stars {
      display: flex;
      gap: 0.25rem;
      margin-bottom: calc(var(--space-6) * -0.5);

      & svg {
        width: 1.25rem;
        height: 1.25rem;
        fill: #d4a955;
      }

      & svg.is-empty {
        fill: none;
        stroke: #d4a955;
        stroke-width: 1.5;
      }
    }

    .quote-card_quote {
      quotes: "\201C" "\201D";

      & > p::before {
        content: open-quote;
      }

      & > p::after {
        content: close-quote;
      }
    }

    .quote-card_caption {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
    }

    .quote-card_name {
      font-weight: var(--primary-medium);
    }

    .quote-card_detail {
      color: color-mix(in lab, currentcolor 60%, transparent);
      font-size: 0.6875rem;
      font-weight: var(--primary-bold);
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
  }
</style>
