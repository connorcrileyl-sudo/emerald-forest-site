---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import RelatedServices from "@/components/content/RelatedServices.astro";
import ServiceSchema from "@/components/content/ServiceSchema.astro";
import glueUp from "@/assets/images/workshop-clamping-glue-up.jpg";
import coffeeTable from "@/assets/images/cherry-coffee-table.jpg";
import boothBenches from "@/assets/images/plywood-booth-benches.jpg";
import { PHONE_HREF } from "@/consts.ts";
import { TOWN_LIST, visibleFaqs, type FaqItem } from "@/utils/faq.ts";

const description =
  "Custom dining tables, live edge tables and bespoke furniture handmade from Western North Carolina hardwood in Black Mountain, NC. Serving Asheville.";

const faqs: FaqItem[] = [
  {
    question: "Where is the furniture made?",
    answer: `Every piece is built in our Black Mountain shop for homes in
      ${TOWN_LIST}, NC, and nearby.`,
  },
  {
    question: "How much does a custom table or piece of furniture cost?",
    answer: `It depends on the size, the wood and how much detail goes into it, so every job gets its own free estimate.`,
  },
];
---

<Layout
  title="Custom Furniture & Live Edge Tables | Black Mountain & Asheville, NC"
  description={description}
>
  <ServiceSchema
    slot="head"
    name="Custom Furniture and Live Edge Tables"
    serviceType="Bespoke furniture"
    description={description}
    image={coffeeTable}
    faqs={faqs}
  />

  <!-- Hero -->
  <Section paddingTop="navoverlap" class="section-glow-center" paddingBottom="large">
    <ContentWrapper variant="columns">
      <Heading tag="h1" variant="h1" maxWidth={16}>
        Custom Furniture and Live Edge Tables in Black Mountain, NC
      </Heading>
      <Paragraph variant="large" maxWidth={36}>
        We build dining tables, live edge tables and one-off pieces in our Black Mountain shop for homes around Asheville.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href={PHONE_HREF}>Call Now</Button>
        <Button element="link" href="/contact/" emphasis="secondary">Free Estimate</Button>
      </ButtonWrapper>
      <Img
        zoom
        slot="column2"
        src={coffeeTable}
        alt="Mid-century modern cherry coffee table with an open shelf and tapered legs"
        loading="eager"
        fetchPriority="high"
      />
    </ContentWrapper>
  </Section>

  <!-- Furniture and cabinets -->
  <Section class="section-alt">
    <ContentWrapper variant="columns" reverse>
      <Heading tag="h2" maxWidth={24}>
        Dining Tables, Live Edge Tables and One-Off Pieces
      </Heading>
      <RichText maxWidth={60}>
        <p>
          Solid hardwood dining tables, live edge tables, benches and pieces that don't fit a category. We settle the size, wood and finish with you, then build it one piece at a time from local timber.
        </p>
        <p>
          Looking for kitchen cabinets, built-ins or shelving? See{" "}
          <a href="/custom-cabinets/">custom cabinets and built-ins</a>.
        </p>
      </RichText>
      <Img
        zoom
        slot="column2"
        src={boothBenches}
        alt="Two built-in booth benches facing each other below a pair of windows"
      />
    </ContentWrapper>
  </Section>

  <!-- Materials -->
  <Section>
    <ContentWrapper variant="columns">
      <Heading tag="h2" maxWidth={24}>
        Local Hardwood
      </Heading>
      <RichText maxWidth={60}>
        <p>
          Lumber grown and milled in Western North Carolina, the same wood as our{" "}
          <a href="/custom-doors/">doors</a> and{" "}
          <a href="/custom-staircases/">staircases</a>.
        </p>
      </RichText>
      <Img
        zoom
        slot="column2"
        src={glueUp}
        alt="Noah clamping thick hardwood boards together on the workbench in his Black Mountain shop"
      />
    </ContentWrapper>
  </Section>



  <!-- FAQ -->
  <Section class="section-alt">
    <ContentWrapper variant="sticky-content">
      <Heading tag="h2" maxWidth={24}>Furniture Questions</Heading>
      <Paragraph maxWidth={30}>
        Something else? <a href="/contact/">Get in touch</a>.
      </Paragraph>
      <Accordion slot="column2" single>
        {visibleFaqs(faqs).map((faq) => (
          <AccordionItem heading={faq.question}>
            <Paragraph set:html={faq.answer} />
          </AccordionItem>
        ))}
      </Accordion>
    </ContentWrapper>
  </Section>

  <RelatedServices current="/custom-furniture/" />
</Layout>
