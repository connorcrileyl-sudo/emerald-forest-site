---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Card from "@/components/item/Card.astro";
import spiralBalusters from "@/assets/images/spiral-staircase-walnut-balusters.jpg";
import arched from "@/assets/images/arched-door-with-trim.jpg";
import photoNeeded from "@/assets/placeholders/photo-needed.svg";
import pergola from "@/assets/images/pergola-with-planters.jpg";
import { PHONE_HREF, TOWNS } from "@/consts.ts";
---

<Layout
  title="Carpentry & Woodworking Services in Black Mountain, NC"
  description="Custom staircases, solid wood doors, furniture, cabinets, finish carpentry and pergolas from a Black Mountain, NC woodshop serving the Asheville area."
>
  <!-- Hero -->
  <Section paddingTop="navoverlap" paddingBottom="large">
    <ContentWrapper centered>
      <Heading tag="h1" variant="h1" maxWidth={16}>
        Carpentry and Woodworking in Black Mountain, NC
      </Heading>
      <Paragraph variant="large" maxWidth={40}>
        Everything we build is made to order in our Black Mountain shop,
        for homes in {TOWNS.slice(0, -1).join(", ")} and {TOWNS.at(-1)}.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href={PHONE_HREF}>Call Now</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <!-- Services -->
  <Section class="section-alt">
    <ContentWrapper>
      <Heading tag="h2" maxWidth={18}>Choose a Service</Heading>
    </ContentWrapper>
    <Grid medium={2}>
      <Card
        variant="stacked"
        image={spiralBalusters}
        imageAlt="Walnut spiral staircase with turned balusters"
        heading="Spiral and Custom Staircases"
        headingTag="h3"
        text="Spiral, curved and straight staircases, stair railings and newel posts in solid hardwood."
        buttonLabel="Staircases"
        buttonHref="/custom-staircases/"
      />
      <Card
        variant="stacked"
        image={arched}
        imageAlt="Arched solid wood door with curved trim"
        heading="Custom Solid Wood Doors"
        headingTag="h3"
        text="Entry doors, arched doors and solid wood interior doors, made to fit your opening."
        buttonLabel="Doors"
        buttonHref="/custom-doors/"
      />
      <Card
        variant="stacked"
        image={photoNeeded}
        imageAlt="Placeholder: furniture photo coming soon"
        heading="Custom Furniture and Cabinets"
        headingTag="h3"
        text="Tables, cabinets and built-ins from Western North Carolina hardwood."
        buttonLabel="Furniture"
        buttonHref="/custom-furniture/"
      />
      <Card
        variant="stacked"
        image={pergola}
        imageAlt="Timber pergola with built-in planter boxes"
        heading="Pergolas and Outdoor Structures"
        headingTag="h3"
        text="Wood pergolas and covered outdoor spaces built from solid timber."
        buttonLabel="Pergolas"
        buttonHref="/pergolas/"
      />
    </Grid>
  </Section>

  <!-- Finish carpentry -->
  <Section>
    <ContentWrapper variant="columns">
      <Heading tag="h2" maxWidth={16}>Trim and Finish Carpentry</Heading>
      <RichText slot="column2" maxWidth={60}>
        <p>
          Alongside the larger pieces, we take on finish carpentry: the
          trim, casings and details that make a room look complete.
        </p>
        <p>
          TODO (Noah): the finish carpentry work you want more of
          (trim, wainscoting, mantels, built-in shelving?).
        </p>
      </RichText>
    </ContentWrapper>
  </Section>

  <!-- Call to action -->
  <Section theme="brand" paddingTop="small" paddingBottom="small">
    <ContentWrapper variant="auto-width">
      <Heading tag="h2" maxWidth={18}>Not Sure Where Your Project Fits?</Heading>
      <Paragraph slot="column2" maxWidth={32}>
        Call Noah and describe what you have in mind.
      </Paragraph>
      <ButtonWrapper slot="column2" marginTop="4">
        <Button element="link" href={PHONE_HREF}>Call Now</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
