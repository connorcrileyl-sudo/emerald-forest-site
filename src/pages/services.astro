---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import ServiceCard from "@/components/item/ServiceCard.astro";
import crownMolding from "@/assets/images/stock-crown-molding-nail-gun.jpg";
import oakNewel from "@/assets/images/oak-stair-newel-post.jpg";
import spiralBalusters from "@/assets/images/spiral-staircase-walnut-balusters.jpg";
import arched from "@/assets/images/arched-door-with-trim.jpg";
import kitchen from "@/assets/images/kitchen-cabinets-copper-sink.jpg";
import wineBuiltIn from "@/assets/images/arched-wine-builtin-hero.jpg";
import coffeeTable from "@/assets/images/cherry-coffee-table.jpg";
import pergola from "@/assets/images/pergola-with-planters.jpg";
import BreadcrumbSchema from "@/components/content/BreadcrumbSchema.astro";
import { PHONE_HREF, TOWNS } from "@/consts.ts";
---

<Layout
  title="Carpentry & Woodworking Services in Black Mountain, NC"
  description="Custom staircases, doors, kitchens, cabinets, furniture, finish carpentry and pergolas from a Black Mountain, NC carpenter."
>
  <BreadcrumbSchema slot="head" trail={[{ label: "Services", href: "/services/" }]} />
  <!-- Hero -->
  <Section paddingTop="navoverlap" class="section-glow-center" paddingBottom="small">
    <ContentWrapper>
      <Heading tag="h1" variant="h1" maxWidth={20}>
        Carpentry and Woodworking in Black Mountain, NC
      </Heading>
      <Paragraph variant="large" maxWidth={40}>
        Custom pieces are made to order in our Black Mountain shop, and
        trim and repairs are done in your home, across{" "}
        {TOWNS.slice(0, -1).join(", ")} and {TOWNS.at(-1)}.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href={PHONE_HREF}>Call Now</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <!-- Services -->
  <Section class="section-alt" paddingTop="small">
    <ContentWrapper>
      <Heading tag="h2" maxWidth={24}>Choose a Service</Heading>
    </ContentWrapper>
    <Grid medium={2} large={3}>
      <ServiceCard
        href="/custom-staircases/"
        image={spiralBalusters}
        imageAlt="Walnut spiral staircase with turned balusters"
        heading="Spiral and Custom Staircases"
        headingTag="h3"
        text="The centerpiece of a home, in solid hardwood."
        items={["Spiral and curved stairs", "Straight stairs", "Squeaky stair repair"]}
        label="Staircases"
      />
      <ServiceCard
        href="/stair-railings/"
        image={oakNewel}
        imageAlt="Chamfered oak newel post at the foot of a straight staircase"
        heading="Stair Railings and Newel Posts"
        headingTag="h3"
        text="New railings for new stairs or the ones you already have."
        items={["Handrails", "Balusters", "Newel posts"]}
        label="Stair Railings"
      />
      <ServiceCard
        href="/custom-doors/"
        image={arched}
        imageAlt="Arched solid wood door with curved trim"
        heading="Custom Solid Wood Doors"
        headingTag="h3"
        text="Carved, paneled and plank doors, made for your opening and built to last."
        items={["Entry doors", "Arched doors", "Interior and barn doors"]}
        label="Doors"
      />
      <ServiceCard
        href="/custom-kitchens/"
        image={kitchen}
        imageAlt="Wood kitchen cabinets with a hammered copper farmhouse sink and stone countertop"
        heading="Custom Kitchens"
        headingTag="h3"
        text="Solid hardwood kitchen cabinets and countertops."
        items={["Kitchen cabinets", "Countertops", "Open shelving"]}
        label="Kitchens"
      />
      <ServiceCard
        href="/custom-cabinets/"
        image={wineBuiltIn}
        imageAlt="Arched built-in wine cabinet with lit shelves set into a dining room wall"
        heading="Cabinets and Built-Ins"
        headingTag="h3"
        text="Built-ins, shelves and mantels in local hardwood."
        items={["Built-ins and bookshelves", "Floating shelves", "Mantels"]}
        label="Cabinets"
      />
      <ServiceCard
        href="/custom-furniture/"
        image={coffeeTable}
        imageAlt="Mid-century modern cherry coffee table with an open shelf and tapered legs"
        heading="Custom Furniture and Live Edge Tables"
        headingTag="h3"
        text="Tables and pieces you won't find in a store, in local hardwood."
        items={["Dining tables", "Live edge tables", "Benches"]}
        label="Furniture"
      />
      <ServiceCard
        href="/finish-carpentry/"
        image={crownMolding}
        imageAlt="Close-up of white crown molding being nailed in where the wall meets the ceiling"
        heading="Trim and Finish Carpentry"
        headingTag="h3"
        text="The details that make a room look finished."
        items={["Crown molding", "Wainscoting", "Window and door trim"]}
        label="Finish Carpentry"
      />
      <ServiceCard
        href="/pergolas/"
        image={pergola}
        imageAlt="Timber pergola with built-in planter boxes"
        heading="Pergolas and Outdoor Structures"
        headingTag="h3"
        text="Shade and outdoor living space, framed in solid timber."
        items={["Pergolas", "Built-in planters", "Covered outdoor spaces"]}
        label="Pergolas"
      />
    </Grid>
  </Section>

</Layout>
