---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Card from "@/components/item/Card.astro";
import ServiceCard from "@/components/item/ServiceCard.astro";
import Img from "@/components/media/Img.astro";
import Icon from "@/components/media/Icon.astro";
import QuoteCard from "@/components/content/QuoteCard.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import FaqSchema from "@/components/content/FaqSchema.astro";
import ServiceMap from "@/components/content/ServiceMap.astro";
import { TOWN_LIST, visibleFaqs, type FaqItem } from "@/utils/faq.ts";
import iconCraft from "@/assets/icons/fa/ruler-triangle.svg";
import iconTree from "@/assets/icons/fa/tree.svg";
import iconLeaf from "@/assets/icons/fa/leaf.svg";
import spiralBalusters from "@/assets/images/spiral-staircase-walnut-balusters.jpg";
import spiralHero from "@/assets/images/spiral-staircase-hero-new.jpg";
import doorOpen from "@/assets/images/walnut-door-carved-panel.jpg";
import kitchenStone from "@/assets/images/kitchen-cabinets-stone-wall.jpg";
import pergola from "@/assets/images/pergola-with-planters.jpg";
import workshop from "@/assets/images/workshop-clamping-glue-up.jpg";
import {
  PHONE_HREF,
  TOWNS,
} from "@/consts.ts";

const homeFaqs: FaqItem[] = [
  {
    question: "How much does custom woodwork cost?",
    answer: `Every job is priced on its own, with a free estimate.`,
  },
  {
    question: "What do you build?",
    answer: `We specialize in
      <a href="/custom-staircases/">staircases</a>,
      <a href="/custom-doors/">doors</a>,
      <a href="/custom-kitchens/">kitchens</a>,
      <a href="/custom-cabinets/">built-ins</a>,
      <a href="/custom-furniture/">furniture</a> and
      <a href="/pergolas/">pergolas</a>, but we're always open to
      custom projects. If you have an idea that isn't on the list,
      ask. See <a href="/services/">all services</a>.`,
  },
  {
    question: "What area do you serve?",
    answer: `The shop is in Black Mountain, and we work in homes in
      ${TOWN_LIST}, NC, and nearby.`,
  },
];
---

<Layout
  title="Emerald Forest Furnishings | Carpenter in Black Mountain, NC"
  description="Handcrafted staircases, solid hardwood doors, custom cabinets and custom furniture from a Black Mountain, NC woodshop serving the Asheville area."
>
  <FaqSchema slot="head" items={homeFaqs} />
  <!-- Hero: text left, photo right with the big corners -->
  <Section paddingTop="navoverlap" class="section-glow-center" paddingBottom="medium">
    <ContentWrapper variant="columns" class="home-hero_layout">
      <Heading tag="h1" variant="h1" class="home-hero_heading">
        <span>Fine Carpentry</span> <span>and Woodworking</span>
      </Heading>
      <Paragraph variant="large" maxWidth={46}>
        <strong>Handmade staircases, doors and furniture</strong> from local
        lumber, for homes around <span style="white-space: nowrap">Black Mountain</span>.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href={PHONE_HREF}>Call Now</Button>
        <Button element="link" href="/contact/" emphasis="secondary">
          Free Estimate
        </Button>
      </ButtonWrapper>
      <div slot="column2" class="home-hero_photo">
        <Img
          zoom
          src={spiralHero}
          alt="Walnut spiral staircase seen from above, with hammered metal treads and turned balusters"
          loading="eager"
          fetchPriority="high"
          sizes="(min-width: 90rem) 42rem, (min-width: 64rem) 46vw, 100vw"
        />
      </div>
    </ContentWrapper>
  </Section>

  <!-- Services -->
  <Section class="section-alt section-glow">
    <ContentWrapper>
      <Heading tag="h2" maxWidth={24}>
        Custom Woodwork for Homes Around Asheville
      </Heading>
    </ContentWrapper>
    <Grid medium={2} large={4}>
      <ServiceCard
        href="/custom-staircases/"
        image={spiralBalusters}
        imageAlt="Curved spiral staircase with a walnut handrail and slim turned balusters"
        heading="Custom Staircases"
        headingTag="h3"
        text="The centerpiece of a home, in solid hardwood."
        items={["Spiral and curved stairs", "Straight stairs", "Railings and newel posts"]}
        label="Staircases"
      />
      <ServiceCard
        href="/custom-doors/"
        image={doorOpen}
        imageAlt="Close-up of a solid walnut door with a carved geometric upper panel"
        heading="Solid Hardwood Doors"
        headingTag="h3"
        text="Carved, paneled and plank doors, made for your opening and built to last."
        items={["Entry doors", "Arched doors", "Interior and barn doors"]}
        label="Doors"
      />
      <ServiceCard
        href="/custom-kitchens/"
        image={kitchenStone}
        imageAlt="L-shaped kitchen cabinets with a dark wood countertop below a stone wall, open shelves and a window"
        heading="Kitchens and Cabinets"
        headingTag="h3"
        text="Kitchens, built-ins and tables in local hardwood."
        items={["Full kitchens", "Built-ins and shelves", "Tables and furniture"]}
        label="Kitchens"
      />
      <ServiceCard
        href="/pergolas/"
        image={pergola}
        imageAlt="Large timber pergola with built-in planter boxes along both sides"
        heading="Pergolas"
        headingTag="h3"
        text="Shade and outdoor living space, framed in solid timber."
        items={["Pergolas", "Built-in planters", "Covered outdoor spaces"]}
        label="Pergolas"
      />
    </Grid>
    <ContentWrapper>
      <ButtonWrapper>
        <Button element="link" href="/services/" emphasis="secondary">
          All Services
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <!-- About -->
  <Section>
    <ContentWrapper variant="columns" reverse>
      <Heading tag="h2" maxWidth={24}>
        Local Craftsmanship, Built to Last
      </Heading>
      <RichText maxWidth={54}>
        <p>
          Emerald Forest Furnishings is our woodshop in Black Mountain.
          Every staircase, door and piece of furniture is made by hand, to last for generations.
        </p>
        <p>
          We build with hardwood grown and milled here in <strong>Western North
          Carolina</strong>.
        </p>
      </RichText>
      <ButtonWrapper>
        <Button element="link" href="/about/" emphasis="secondary">
          About the Shop
        </Button>
      </ButtonWrapper>
      <Img
        zoom
        slot="column2"
        src={workshop}
        alt="Noah clamping thick hardwood boards together at the bench in his Black Mountain shop"
      />
    </ContentWrapper>
  </Section>

  <!-- Why choose us -->
  <Section class="section-alt section-glow">
    <ContentWrapper variant="auto-width">
      <Heading tag="h2" maxWidth={24}>Handcrafted Quality in Every Detail</Heading>
    </ContentWrapper>
    <Grid small={2} large={3}>
      <ContentWrapper>
        <Icon src={iconCraft} variant="large" class="feature-icon" />
        <Heading tag="h3" variant="h5">Handcrafted to Fit</Heading>
        <Paragraph>
          Size, wood, shape and detail are all yours to choose, even for spiral stairs and arched
          doorways that off-the-shelf parts can't fit.
        </Paragraph>
      </ContentWrapper>
      <ContentWrapper>
        <Icon src={iconTree} variant="large" class="feature-icon" />
        <Heading tag="h3" variant="h5">Local Hardwood</Heading>
        <Paragraph>
          Lumber grown and milled in Western North Carolina, from local
          sawmills. Your project supports local sawyers and craftsmen,
          not a factory overseas.
        </Paragraph>
      </ContentWrapper>
      <ContentWrapper>
        <Icon src={iconLeaf} variant="large" class="feature-icon" />
        <Heading tag="h3" variant="h5">Safe Finishes</Heading>
        <Paragraph>
          The safest, most eco-friendly finish for each job, sourced
          locally where we can.
        </Paragraph>
      </ContentWrapper>
    </Grid>
  </Section>

  <!-- Reviews -->
  <Section>
    <ContentWrapper>
      <Heading tag="h2" maxWidth={24}>What Our Clients Say</Heading>
    </ContentWrapper>
    <Grid medium={3}>
      <QuoteCard
        quote="Noah has excellent attention to detail and communication. He offered insights and solutions into some of the complications of our projects executed the vision perfectly. The price was great given the quality provided. Will call again when we are ready for our next project. Thanks Noah!"
        name="Mike W"
        highlight={["excellent attention to detail and communication.", "Thanks Noah!"]}
        detail="Google review"
        rating={5}
      />
      <QuoteCard
        quote="Working with Emerald Forest was a pleasure. Excellent communication and workmanship. Great eye for detail aesthetic. Reasonable pricing for high quality work. We will definitely use this service again."
        name="Brandon Greenstein"
        highlight={["Excellent communication and workmanship.", "We will definitely use this service again."]}
        detail="Google review"
        rating={5}
      />
      <QuoteCard
        quote="Great experience. Very happy with the end product, timeline, and communication"
        name="Cameron White"
        highlight={["Great experience."]}
        detail="Google review"
        rating={5}
      />
    </Grid>
  </Section>

  <!-- Towns served -->
  <Section class="section-alt section-glow">
    <ContentWrapper variant="columns">
      <Heading tag="h2" maxWidth={24}>
        Serving Black Mountain, Asheville and the Swannanoa Valley
      </Heading>
      <RichText maxWidth={54}>
        <p>
          The shop is in Black Mountain, and we build and install
          staircases, doors, furniture and pergolas for homes across
          the area, including:
        </p>
        <ul>
          {TOWNS.map((town) => <li>{town}, NC</li>)}
        </ul>
        <p>
          Further out, or not sure if you're in our area? Give us a
          call. We're happy to talk through your options.
        </p>
      </RichText>
      <ServiceMap slot="column2" />
    </ContentWrapper>
  </Section>

  <!-- FAQ -->
  <Section>
    <ContentWrapper variant="sticky-content">
      <Heading tag="h2" maxWidth={24}>Common Questions</Heading>
      <Paragraph maxWidth={30}>
        Something else? <a href="/contact/">Get in touch</a>.
      </Paragraph>
      <Accordion slot="column2" single>
        {visibleFaqs(homeFaqs).map((faq) => (
          <AccordionItem heading={faq.question}>
            <Paragraph set:html={faq.answer} />
          </AccordionItem>
        ))}
      </Accordion>
    </ContentWrapper>
  </Section>
</Layout>

<style is:global>
  /* Home hero: pull the heading and photo a little closer together.
     Unlayered so it beats the ContentWrapper component layer. */
  .layout.columns.home-hero_layout {
    column-gap: calc(var(--section-space-small) * 0.65);
    @media (width >= 64rem) {
      grid-template-columns: 0.85fr 1fr;
    }
  }
  /* More air between heading, intro and buttons. */
  .home-hero_layout .home-hero_heading {
    margin-bottom: var(--space-6);
  }
  /* "Fine Carpentry / and Woodworking", never a lone "and". */
  @media (width >= 40rem) {
    .home-hero_heading > span {
      white-space: nowrap;
    }
  }
  .home-hero_layout .button-wrapper {
    margin-top: var(--space-8);
    gap: var(--space-4);
  }
  /* Photo a touch smaller on desktop; full square, no crop. */
  .home-hero_layout .home-hero_photo {
    @media (width >= 64rem) {
      width: 88%;
      align-self: center;
    }
  }
</style>
