---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import RelatedServices from "@/components/content/RelatedServices.astro";
import ServiceSchema from "@/components/content/ServiceSchema.astro";
/* Stock photos (Envato): general close-ups, not Noah's work. */
import deckPergola from "@/assets/images/raised-deck-and-pergola.jpg";
import deckClose from "@/assets/images/stock-deck-boards-close-up.jpg";
import staining from "@/assets/images/stock-staining-wood-brush.jpg";
import { BUSINESS, PHONE_HREF } from "@/consts.ts";
import { TOWN_LIST, visibleFaqs, type FaqItem } from "@/utils/faq.ts";

const description =
  "New wood decks, deck repair and deck staining by a Black Mountain, NC carpenter: rotten boards, rails and stairs replaced. Serving Asheville and nearby.";

const faqs: FaqItem[] = [
  {
    question: "Should I repair or replace my deck?",
    answer: `If the frame underneath is sound, replacing the worn boards,
      rails or stairs is usually enough. If the posts or joists are
      rotten, a rebuild may be the better fix. Send photos and we'll
      tell you which.`,
  },
  {
    question: "What are the signs a deck needs repair?",
    answer: `Boards that feel soft or spongy underfoot, cracked or
      splintered boards, wobbly railings, loose stairs, and grey wood
      that soaks up water instead of beading it.`,
  },
  {
    question: "Do you repair decks outside Black Mountain?",
    answer: `Yes. We build new decks and repair and restain existing ones
      at homes in ${TOWN_LIST}, NC, and nearby.`,
  },
  {
    question: "How much does a deck or deck repair cost?",
    answer: `It depends on the size, whether it's a new deck or a repair, and the railings and stairs. Give us a call or
      send a few photos, and we'll gladly put together a free estimate.`,
  },
  {
    question: "How do I get an estimate?",
    answer: `Call ${BUSINESS.phone}, or send photos of the deck and rough
      measurements through the <a href="/contact/">contact page</a>.`,
  },
];
---

<Layout
  title="Decks, Deck Repair & Staining | Black Mountain & Asheville, NC"
  description={description}
>
  <ServiceSchema
    slot="head"
    name="Decks, Deck Repair and Staining"
    serviceType="Deck building and repair"
    description={description}
    image={deckPergola}
    faqs={faqs}
  />

  <!-- Hero -->
  <Section paddingTop="navoverlap" class="section-glow-center" paddingBottom="large">
    <ContentWrapper variant="columns">
      <Heading tag="h1" variant="h1" maxWidth={16}>
        Decks, Deck Repair and Staining in Black Mountain, NC
      </Heading>
      <Paragraph variant="large" maxWidth={36}>
        We build new wood decks and bring tired ones back for homes
        around Black Mountain and Asheville: soft boards replaced, rails
        and stairs made solid, and the whole deck cleaned and restained.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href={PHONE_HREF}>Call Now</Button>
        <Button element="link" href="/contact/" emphasis="secondary">Free Estimate</Button>
      </ButtonWrapper>
      <Img
        slot="column2"
        src={deckPergola}
        alt="Raised wood deck with wire-panel railings beside a pergola and planters, with mountains behind"
        loading="eager"
        fetchPriority="high"
      />
    </ContentWrapper>
  </Section>

  <!-- New decks -->
  <Section class="section-alt">
    <ContentWrapper variant="columns" reverse>
      <Heading tag="h2" maxWidth={24}>New Wood Decks</Heading>
      <RichText maxWidth={60}>
        <p>
          We build new wood decks designed around your house and yard,
          with stairs and railings to match. A deck can also be paired with
          a <a href="/pergolas/">pergola</a> for shade.
        </p>
      </RichText>
      <Img
        slot="column2"
        src={deckClose}
        alt="Close-up of evenly spaced, freshly stained wooden deck boards"
      />
    </ContentWrapper>
  </Section>

  <!-- Repair and staining -->
  <Section>
    <ContentWrapper variant="columns">
      <Heading tag="h2" maxWidth={24}>Deck Repair and Staining</Heading>
      <RichText maxWidth={60}>
        <p>
          Most decks don't need replacing, just repair. We replace soft or
          rotten deck boards, loose or broken railings and worn stairs,
          then clean and restain the deck so the old and new wood match.
        </p>
        <p>
          Rot around the rest of the house too? See{" "}
          <a href="/wood-rot-repair/">wood rot repair</a> for sills, door
          frames and porches.
        </p>
      </RichText>
      <Img
        slot="column2"
        src={staining}
        alt="Gloved hand brushing dark wood stain onto a row of boards"
      />
    </ContentWrapper>
  </Section>

  <!-- FAQ -->
  <Section class="section-alt">
    <ContentWrapper variant="sticky-content">
      <Heading tag="h2" maxWidth={14}>Deck Questions</Heading>
      <Paragraph maxWidth={30}>
        Something else? <a href="/contact/">Get in touch</a>.
      </Paragraph>
      <Accordion slot="column2" single>
        {visibleFaqs(faqs).map((faq) => (
          <AccordionItem heading={faq.question}>
            <Paragraph set:html={faq.answer} />
          </AccordionItem>
        ))}
      </Accordion>
    </ContentWrapper>
  </Section>

  <RelatedServices current="/decks/" />
</Layout>
