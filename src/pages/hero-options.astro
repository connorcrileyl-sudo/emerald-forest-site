---
/* Preview page (noindex): frame treatments for the home hero photo. */
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Img from "@/components/media/Img.astro";
import spiral from "@/assets/images/spiral-staircase-hero.png";

const options = [
  { id: "a", name: "A. Offset gold outline", note: "A hairline gold frame set behind the photo, nudged down and left." },
  { id: "b", name: "B. Inset double rule", note: "Two fine gold lines inside the photo, like a framed print." },
  { id: "c", name: "C. Corner flourishes", note: "Gold corner brackets on the two square corners." },
  { id: "d", name: "D. Gold edge and glow", note: "A thin lit-gold border with a soft warm glow." },
];
---

<Layout title="Hero Frame Options" description="Preview of hero photo frames.">
  <Section paddingTop="navoverlap">
    <ContentWrapper>
      <Heading tag="h1" variant="h2">Hero Photo Frames</Heading>
      <Paragraph>Pick one (or mix): A, B, C or D.</Paragraph>
    </ContentWrapper>
    <div class="frame-grid">
      {options.map((o) => (
        <figure class="frame-opt">
          <div class:list={["hero-frame", `hero-frame--${o.id}`]}>
            <div class="home-hero_photo">
              <Img src={spiral} alt="" />
            </div>
            {o.id === "c" && (
              <>
                <span class="flourish flourish--tl" aria-hidden="true" />
                <span class="flourish flourish--br" aria-hidden="true" />
              </>
            )}
          </div>
          <figcaption>
            <strong>{o.name}</strong>
            <span>{o.note}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </Section>
</Layout>

<style is:global>
  .frame-grid {
    width: var(--site-width);
    max-width: var(--max-width-main);
    margin: var(--space-8) auto 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr));
    gap: 5rem 4rem;
  }

  .frame-opt {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    & figcaption {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      & strong { color: var(--heading-text); font-size: 1.125rem; }
      & span { color: var(--text-2); font-size: var(--text-small); }
    }
  }

  .hero-frame {
    --r: clamp(2rem, 6vw, 4.5rem);
    --gold: #cb9033;
    position: relative;
    isolation: isolate;
  }

  /* A: offset outline behind the photo */
  .hero-frame--a::before {
    content: "";
    position: absolute;
    inset: 0;
    translate: -1.25rem 1.25rem;
    border: 1px solid color-mix(in lab, var(--gold) 70%, transparent);
    border-radius: 0 var(--r) 0 var(--r);
    z-index: -1;
  }

  /* B: inset double rule over the photo */
  .hero-frame--b::after {
    content: "";
    position: absolute;
    inset: 0.9rem;
    border: 1px solid color-mix(in lab, var(--gold) 85%, transparent);
    outline: 1px solid color-mix(in lab, var(--gold) 45%, transparent);
    outline-offset: 0.3rem;
    border-radius: 0 calc(var(--r) - 0.9rem) 0 calc(var(--r) - 0.9rem);
    pointer-events: none;
  }

  /* C: corner brackets outside the square corners */
  .flourish {
    position: absolute;
    width: 4.5rem;
    height: 4.5rem;
    border-color: var(--gold);
    border-style: solid;
    pointer-events: none;
  }
  .flourish::after {
    content: "";
    position: absolute;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--gold);
    rotate: 45deg;
  }
  .flourish--tl {
    top: -0.9rem;
    left: -0.9rem;
    border-width: 1px 0 0 1px;
    &::after { top: -0.2rem; left: -0.2rem; }
  }
  .flourish--br {
    bottom: -0.9rem;
    right: -0.9rem;
    border-width: 0 1px 1px 0;
    &::after { bottom: -0.2rem; right: -0.2rem; }
  }

  /* D: lit-gold edge with a soft glow */
  .hero-frame--d .home-hero_photo {
    border: 2px solid transparent;
    background:
      linear-gradient(#000, #000) padding-box,
      linear-gradient(160deg, #e2a948, #a8762a 45%, #d49a40 75%, #8f6222) border-box;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.6),
      0 10px 40px -10px rgb(203 144 51 / 0.35);
  }
</style>
