---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Form from "@/components/form/Form.astro";
import Fieldset from "@/components/form/Fieldset.astro";
import Input from "@/components/form/Input.astro";
import Textarea from "@/components/form/Textarea.astro";
import { BUSINESS, PHONE_HREF, FORM_ENDPOINT } from "@/consts.ts";
---

<Layout
  title="Contact"
  description="TODO: how to reach the business, for search results."
>
  <!-- Hero -->
  <Section paddingTop="large" paddingBottom="large">
    <ContentWrapper centered>
      <Eyebrow>Plumbing and heating in Springfield</Eyebrow>
      <Heading tag="h1" variant="display" maxWidth={14}>
        Say what you do in a few words
      </Heading>
      <Paragraph variant="large" maxWidth={36}>
        One or two sentences on the result the customer gets.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href="/contact">Get a quote</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <!-- Contact details and form -->
  <Section>
    <ContentWrapper variant="sticky-content">
      <Eyebrow>Contact</Eyebrow>
      <Heading tag="h2" maxWidth={14}>Get in touch</Heading>
      <Paragraph maxWidth={32}>
        Say how fast they will hear back, and the best way to reach you.
      </Paragraph>
      <RichText>
        {BUSINESS.phone && (
          <p>
            <strong>Phone</strong>
            <br />
            <a href={PHONE_HREF}>{BUSINESS.phone}</a>
          </p>
        )}
        {BUSINESS.email && (
          <p>
            <strong>Email</strong>
            <br />
            <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
          </p>
        )}
        {BUSINESS.address.length > 0 && (
          <p>
            <strong>Address</strong>
            <br />
            <Fragment set:html={BUSINESS.address.join("<br />")} />
          </p>
        )}
        {BUSINESS.hours.length > 0 && (
          <p>
            <strong>Hours</strong>
            <br />
            <Fragment set:html={BUSINESS.hours.join("<br />")} />
          </p>
        )}
      </RichText>
      <Form slot="column2" name="contact" action={FORM_ENDPOINT}>
        <Fieldset legend="Your details" legendStyle="label">
          <Input variant="first-name" required />
          <Input variant="email" required />
          <Input variant="phone" />
          <Textarea label="How can we help?" required />
        </Fieldset>
        <ButtonWrapper marginTop="4">
          <Button type="submit">Send message</Button>
        </ButtonWrapper>
      </Form>
    </ContentWrapper>
  </Section>
</Layout>
