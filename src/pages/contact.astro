---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Form from "@/components/form/Form.astro";
import Fieldset from "@/components/form/Fieldset.astro";
import Input from "@/components/form/Input.astro";
import Textarea from "@/components/form/Textarea.astro";
import Select from "@/components/form/Select.astro";
import BreadcrumbSchema from "@/components/content/BreadcrumbSchema.astro";
import { BUSINESS, PHONE_HREF, FORM_ENDPOINT, TOWNS } from "@/consts.ts";
---

<Layout
  title="Contact & Estimates | Black Mountain, NC"
  description="Call Emerald Forest Furnishings on (828) 424-5401 or send project details for an estimate on custom staircases, doors and furniture near Asheville."
>
  <BreadcrumbSchema slot="head" trail={[{ label: "Contact", href: "/contact/" }]} />
  <!-- Hero: short intro and details on the left, the form beside it
       so it sits above the fold on desktop -->
  <Section paddingTop="navoverlap" class="section-glow-center" paddingBottom="large">
    <ContentWrapper variant="sticky-content">
      <Heading tag="h1" variant="h1" maxWidth={14}>
        Contact Noah
      </Heading>
      <Paragraph variant="large" maxWidth={32}>
        Call for the quickest answer, or tell us what you'd like built
        and we'll get back to you with next steps.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href={PHONE_HREF}>Call {BUSINESS.phone}</Button>
      </ButtonWrapper>
      <RichText class="contact-details">
        {BUSINESS.email && (
          <p>
            <strong>Email</strong>
            <br />
            <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
          </p>
        )}
        <p>
          <strong>Area served</strong>
          <br />
          {TOWNS.join(", ")}, NC
        </p>
        {import.meta.env.DEV && (
          <p>
            TODO (Noah): your real working hours, and how quickly you
            usually reply to messages.
          </p>
        )}
        {BUSINESS.hours.length > 0 && (
          <p>
            <strong>Hours</strong>
            <br />
            <Fragment set:html={BUSINESS.hours.join("<br />")} />
          </p>
        )}
      </RichText>
      <Form slot="column2" name="contact" action={FORM_ENDPOINT}>
        <Fieldset legend="Your details" legendStyle="label">
          <Input variant="first-name" required />
          <Input variant="email" required />
          <Input variant="phone" />
          <Select
            label="How did you hear about us?"
            name="referral"
            placeholder="Choose one (optional)"
            options={[
              "Google search",
              "Google Maps",
              "ChatGPT or another AI assistant",
              "Instagram",
              "Facebook",
              "A friend or neighbor",
              "Saw our work in person",
              "Other",
            ]}
          />
          <Textarea label="What would you like built or repaired?" required />
        </Fieldset>
        <ButtonWrapper marginTop="4">
          <Button type="submit">Send message</Button>
        </ButtonWrapper>
      </Form>
    </ContentWrapper>
  </Section>
</Layout>

<style is:global>
  /* Left column: room between the call button and the details, and
     between each detail, so it doesn't read as one cramped block. */
  .contact-details {
    margin-top: var(--space-6);
    & > * + * {
      margin-top: var(--space-5);
    }
  }
  /* Two fields per row from tablet width up, so the whole form (and its
     Send button) fits above the fold on a laptop. Unlayered to beat the
     Fieldset component's own grid. */
  form[name="contact"] .form-fieldset_fields {
    gap: var(--space-4);
    @media (width >= 40rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      & > .form-textarea {
        grid-column: 1 / -1;
      }
    }
  }
</style>
