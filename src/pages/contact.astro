---
import Breadcrumbs from "@/components/content/Breadcrumbs.astro";
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import Form from "@/components/form/Form.astro";
import Fieldset from "@/components/form/Fieldset.astro";
import Input from "@/components/form/Input.astro";
import Textarea from "@/components/form/Textarea.astro";
import TownList from "@/components/content/TownList.astro";
import { BUSINESS, PHONE_HREF, FORM_ENDPOINT, WEB3FORMS_KEY } from "@/consts.ts";
---

<Layout
  title="Contact & Free Estimates"
  description="Call Emerald Forest Furnishings at (828) 424-5401 or send project details for an estimate on custom staircases, doors and furniture in the Asheville area."
>
  <!-- Hero: short intro and details on the left, the form beside it
       so it sits above the fold on desktop -->
  <Section paddingTop="navoverlap" class="section-glow-center" paddingBottom="large">
    <ContentWrapper variant="sticky-content">
      <Breadcrumbs trail={[{ label: "Contact", href: "/contact/" }]} />
      <Heading tag="h1" variant="h1" maxWidth={14}>
        Get in Touch
      </Heading>
      <Paragraph variant="large" maxWidth={32}>
        Tell us a little about your project and we'll get back to you.
        Still figuring it out? That's fine, we're happy to talk it
        through.
      </Paragraph>
      <Paragraph maxWidth={32}>
        Or just give us a call.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href={PHONE_HREF}>Call {BUSINESS.phone}</Button>
      </ButtonWrapper>
      <div class="contact-details">
        {BUSINESS.email && (
          <div class="contact-detail">
            <p class="contact-detail_label">Email</p>
            <a class="contact-detail_value" href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
          </div>
        )}
        <div class="contact-detail">
          <p class="contact-detail_label">Area served</p>
          <TownList />
        </div>
        {BUSINESS.hours.length > 0 && (
          <div class="contact-detail">
            <p class="contact-detail_label">Hours</p>
            <p class="contact-detail_value"><Fragment set:html={BUSINESS.hours.join("<br />")} /></p>
          </div>
        )}
      </div>
      <Form
        slot="column2"
        name="contact"
        action={FORM_ENDPOINT}
        successMessage={`Thanks for getting in touch. We'll get back to you soon. Need us sooner? Call ${BUSINESS.phone}.`}
        errorMessage={`That did not send. Please call ${BUSINESS.phone} instead.`}
      >
        {/* Web3Forms settings, sent with every message. */}
        <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
        <input type="hidden" name="subject" value="New message from the website" />
        <input type="hidden" name="from_name" value="Emerald Forest website" />
        {/* Spam trap: hidden from people, ticked by bots. */}
        <input type="checkbox" name="botcheck" class="is-hidden" style="display:none" tabindex="-1" autocomplete="off" />
        <Fieldset legend="Send us a note" legendStyle="hidden">
          <Input variant="first-name" label="Your name" name="name" placeholder="Your name" required />
          <Input variant="email" name="email" placeholder="you@example.com" required />
          <Input variant="phone" label="Phone (optional)" name="phone" placeholder="Phone" />
          <Textarea
            label="What can we help with?"
            name="message"
            placeholder="A few lines is plenty. Rough ideas are welcome."
            required
          />
        </Fieldset>
        <ButtonWrapper>
          <Button type="submit">Send Message</Button>
        </ButtonWrapper>
      </Form>
    </ContentWrapper>
  </Section>
</Layout>

<style is:global>
  /* Left column: room between the call button and the details, and
     between each detail, so it doesn't read as one cramped block. */
  .contact-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    width: 100%;
    margin-top: var(--space-8);
  }
  .contact-detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  /* Small gold label over each detail, so the eye finds them fast. */
  .contact-detail_label {
    margin: 0;
    font-size: 0.75rem;
    font-weight: var(--primary-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--heading-text, currentcolor);
  }
  .contact-detail_value {
    margin: 0;
    font-size: var(--text-large);
    color: var(--text);
  }
  /* Two fields per row from tablet width up, so the whole form (and its
     Send button) fits above the fold on a laptop. Unlayered to beat the
     Fieldset component's own grid. */
  /* Tighter gap between the message box and the Send button than the
     form's default. */
  form[name="contact"] {
    row-gap: var(--space-5);
    & > .button-wrapper {
      margin-top: 0;
    }
  }
  form[name="contact"] .form-fieldset_fields {
    gap: var(--space-4);
    @media (width >= 40rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      & > .form-textarea {
        grid-column: 1 / -1;
      }
    }
  }
</style>
