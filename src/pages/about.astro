---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import Icon from "@/components/media/Icon.astro";
import check from "@/assets/icons/check.svg";
import workshop from "@/assets/images/woodworker-in-workshop.jpg";
import lumber from "@/assets/images/workshop-lumber-and-machines.jpg";
import { PHONE_HREF, TOWNS } from "@/consts.ts";
---

<Layout
  title="About Noah, Carpenter & Woodworker in Black Mountain, NC"
  description="Emerald Forest Furnishings is Noah's woodworking and finish carpentry shop in Black Mountain, NC, building with local hardwood and non-toxic finishes."
>
  <!-- Hero -->
  <Section paddingTop="navoverlap" paddingBottom="large">
    <ContentWrapper variant="columns">
      <Heading tag="h1" variant="h1" maxWidth={16}>
        A Woodworking Shop in Black Mountain, NC
      </Heading>
      <Paragraph variant="large" maxWidth={36}>
        Emerald Forest Furnishings is Noah's carpentry and woodworking
        shop in Black Mountain, NC, building custom staircases, doors,
        furniture and finish carpentry for homes across the area.
      </Paragraph>
      <Img
        slot="column2"
        src={workshop}
        alt="Noah at his workbench, assembling a hardwood stair rail section"
        loading="eager"
        fetchPriority="high"
      />
    </ContentWrapper>
  </Section>

  <!-- Story -->
  <Section class="section-alt">
    <ContentWrapper variant="columns" reverse>
      <Heading tag="h2" maxWidth={16}>Built for Each Client's Home</Heading>
      <RichText maxWidth={60}>
        <p>
          We make bespoke pieces designed around each client's vision and
          the space they're going in: custom stairs, handcrafted doors,
          cabinets and furniture. Each one is meant to be both beautiful
          and practical to live with.
        </p>
        <p>
          TODO (Noah): how many years you've been doing carpentry, how you
          got started, and what you enjoy building most. Two or three
          sentences in your own words is perfect.
        </p>
        <p>
          TODO (Noah): are you licensed and insured? If so, say which
          licence so we can mention it.
        </p>
      </RichText>
      <Img
        slot="column2"
        src={lumber}
        alt="Rough-sawn local hardwood stacked in the Emerald Forest Furnishings shop"
      />
    </ContentWrapper>
  </Section>

  <!-- Values -->
  <Section>
    <ContentWrapper variant="auto-width">
      <Heading tag="h2" maxWidth={16}>Quality, Honesty and Local Materials</Heading>
      <Paragraph slot="column2" maxWidth={32}>
        The principles behind every project.
      </Paragraph>
    </ContentWrapper>
    <Grid small={2} large={3}>
      <ContentWrapper>
        <Icon src={check} variant="large" />
        <Heading tag="h3" variant="h5">Quality and Integrity</Heading>
        <Paragraph>
          Work held to a high standard, open communication, and respect
          for both the craft and the client.
        </Paragraph>
      </ContentWrapper>
      <ContentWrapper>
        <Icon src={check} variant="large" />
        <Heading tag="h3" variant="h5">Local, Bioregional Wood</Heading>
        <Paragraph>
          Lumber from trees grown and milled in Western North Carolina,
          sourced from local sawmills.
        </Paragraph>
      </ContentWrapper>
      <ContentWrapper>
        <Icon src={check} variant="large" />
        <Heading tag="h3" variant="h5">Non-Toxic Finishes</Heading>
        <Paragraph>
          A zero-VOC, food-safe hard wax oil as our usual finish, with
          non-toxic, environmentally sourced hardware.
        </Paragraph>
      </ContentWrapper>
    </Grid>
  </Section>

  <!-- Area -->
  <Section class="section-alt">
    <ContentWrapper variant="columns">
      <Heading tag="h2" maxWidth={16}>Based in Black Mountain</Heading>
      <RichText slot="column2" maxWidth={60}>
        <p>We build for homes in:</p>
        <ul>
          {TOWNS.map((town) => <li>{town}, NC</li>)}
        </ul>
      </RichText>
    </ContentWrapper>
  </Section>

  <!-- Call to action -->
  <Section theme="brand" paddingTop="small" paddingBottom="small">
    <ContentWrapper variant="auto-width">
      <Heading tag="h2" maxWidth={18}>Let's Talk About Your Project</Heading>
      <Paragraph slot="column2" maxWidth={32}>
        Call Noah, or send a few details through the contact page.
      </Paragraph>
      <ButtonWrapper slot="column2" marginTop="4">
        <Button element="link" href={PHONE_HREF}>Call Now</Button>
        <Button element="link" href="/contact/" emphasis="secondary">
          Contact
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
