---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import Icon from "@/components/media/Icon.astro";
import iconQuality from "@/assets/icons/fa/award-simple.svg";
import iconTree from "@/assets/icons/fa/tree.svg";
import iconLeaf from "@/assets/icons/fa/leaf.svg";
import workshop from "@/assets/images/woodworker-in-workshop.jpg";
import lumber from "@/assets/images/workshop-lumber-and-machines.jpg";
import BreadcrumbSchema from "@/components/content/BreadcrumbSchema.astro";
import { PHONE_HREF, TOWNS } from "@/consts.ts";
---

<Layout
  title="About Noah, Carpenter & Woodworker in Black Mountain, NC"
  description="Emerald Forest Furnishings is Noah's woodworking and finish carpentry shop in Black Mountain, NC, building with local hardwood and non-toxic finishes."
>
  <BreadcrumbSchema slot="head" trail={[{ label: "About", href: "/about/" }]} />
  <!-- Hero -->
  <Section paddingTop="navoverlap" class="section-glow-center" paddingBottom="large">
    <ContentWrapper variant="columns">
      <Heading tag="h1" variant="h1" maxWidth={16}>
        A Woodworking Shop in Black Mountain, NC
      </Heading>
      <Paragraph variant="large" maxWidth={36}>
        Emerald Forest Furnishings is a woodworking and finish carpentry
        shop in Black Mountain, in the Appalachian Mountains of Western
        North Carolina. We build custom stairs, cabinets, handcrafted
        doors and one-of-a-kind furniture for homes across the area.
      </Paragraph>
      <Img
        slot="column2"
        src={workshop}
        alt="Noah at his workbench, assembling a hardwood stair rail section"
        loading="eager"
        fetchPriority="high"
      />
    </ContentWrapper>
  </Section>

  <!-- Story -->
  <Section class="section-alt">
    <ContentWrapper variant="columns" reverse>
      <Heading tag="h2" maxWidth={24}>Care in Every Project</Heading>
      <RichText maxWidth={60}>
        <p>
          Every piece starts with a conversation: your ideas, how you'll
          use it, and the space it's for. We work out the design together
          and keep you in the loop as it comes together.
        </p>
        <p>
          Then it's built by hand in our Black Mountain shop, one piece at
          a time, from solid local hardwood. Each part is cut, shaped,
          fitted and finished with care, so it looks good and holds up to
          everyday use for years.
        </p>
        <p>
          For bigger projects, we team up with skilled local craftsmen we
          trust, so a whole kitchen or staircase gets the same attention
          as a single shelf.
        </p>
        {import.meta.env.DEV && (
          <p>
            TODO (Noah): how many years you've been doing carpentry, how
            you got started, and what you enjoy building most. Two or
            three sentences in your own words is perfect.
          </p>
        )}
        {import.meta.env.DEV && (
          <p>
            TODO (Noah): are you licensed and insured? If so, say which
            licence so we can mention it.
          </p>
        )}
      </RichText>
      <Img
        slot="column2"
        src={lumber}
        alt="Rough-sawn local hardwood stacked in the Emerald Forest Furnishings shop"
      />
    </ContentWrapper>
  </Section>

  <!-- Values -->
  <Section>
    <ContentWrapper variant="auto-width">
      <Heading tag="h2" maxWidth={24}>Quality, Community and Local Materials</Heading>
    </ContentWrapper>
    <Grid small={2} large={3}>
      <ContentWrapper>
        <Icon src={iconQuality} variant="large" class="feature-icon" />
        <Heading tag="h3" variant="h5">Quality and Integrity</Heading>
        <Paragraph>
          Careful work and honest communication, from the first
          conversation to the last coat of finish.
        </Paragraph>
      </ContentWrapper>
      <ContentWrapper>
        <Icon src={iconTree} variant="large" class="feature-icon" />
        <Heading tag="h3" variant="h5">Local, Bioregional Wood</Heading>
        <Paragraph>
          Lumber from trees grown and milled here in Western North
          Carolina, bought from local sawmills, so the work supports the
          community too.
        </Paragraph>
      </ContentWrapper>
      <ContentWrapper>
        <Icon src={iconLeaf} variant="large" class="feature-icon" />
        <Heading tag="h3" variant="h5">Non-Toxic Finishes</Heading>
        <Paragraph>
          Our go-to finish is a zero-VOC, food-safe hard wax oil, paired
          with non-toxic hardware and the best quality fittings we can
          find.
        </Paragraph>
      </ContentWrapper>
    </Grid>
  </Section>

  <!-- Area -->
  <Section class="section-alt">
    <ContentWrapper variant="columns">
      <Heading tag="h2" maxWidth={24}>Based in Black Mountain</Heading>
      <RichText slot="column2" maxWidth={60}>
        <p>We build for homes in:</p>
        <ul>
          {TOWNS.map((town) => <li>{town}, NC</li>)}
        </ul>
      </RichText>
    </ContentWrapper>
  </Section>
</Layout>
