---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import Icon from "@/components/media/Icon.astro";
import iconQuality from "@/assets/icons/fa/award-simple.svg";
import iconTree from "@/assets/icons/fa/tree.svg";
import iconLeaf from "@/assets/icons/fa/leaf.svg";
import workshop from "@/assets/images/woodworker-in-workshop.jpg";
import lumber from "@/assets/images/workshop-lumber-and-machines.jpg";
import TownList from "@/components/content/TownList.astro";
import BreadcrumbSchema from "@/components/content/BreadcrumbSchema.astro";
import { PHONE_HREF, TOWNS } from "@/consts.ts";
---

<Layout
  title="About Our Woodworking Shop in Black Mountain, NC"
  description="Emerald Forest Furnishings is a woodworking and finish carpentry shop in Black Mountain, NC, building with local hardwood and safe, eco-friendly finishes."
>
  <BreadcrumbSchema slot="head" trail={[{ label: "About", href: "/about/" }]} />
  <!-- Hero -->
  <Section paddingTop="navoverlap" class="section-glow-center" paddingBottom="large">
    <ContentWrapper variant="columns">
      <Heading tag="h1" variant="h1" maxWidth={16}>
        A Woodworking Shop in Black Mountain, NC
      </Heading>
      <Paragraph variant="large" maxWidth={36}>
        Emerald Forest Furnishings is a woodworking and finish carpentry
        shop in Black Mountain, in the Appalachian Mountains of Western
        North Carolina. We build custom stairs, cabinets, handcrafted
        doors and one-of-a-kind furniture for homes across the area.
      </Paragraph>
      <Img
        zoom
        slot="column2"
        src={workshop}
        alt="Noah at his workbench, assembling a hardwood stair rail section"
        loading="eager"
        fetchPriority="high"
        sizes="(min-width: 90rem) 42rem, (min-width: 64rem) 46vw, 100vw"
      />
    </ContentWrapper>
  </Section>

  <!-- Story -->
  <Section class="section-alt">
    <ContentWrapper variant="columns" reverse>
      <Heading tag="h2" maxWidth={24}>Care in Every Project</Heading>
      <RichText maxWidth={54}>
        <p>
          Every piece starts with a conversation about what you want. We work out the design together and keep you in the loop while it's built.
        </p>
        <p>
          It's built by hand in our Black Mountain shop from solid local hardwood, made to hold up to everyday use for years.
        </p>
      </RichText>
      <Img
        zoom
        slot="column2"
        src={lumber}
        alt="Rough-sawn local hardwood stacked in the Emerald Forest Furnishings shop"
      />
    </ContentWrapper>
  </Section>

  <!-- Values -->
  <Section>
    <ContentWrapper variant="auto-width">
      <Heading tag="h2" maxWidth={24}>Quality, Community and Local Materials</Heading>
    </ContentWrapper>
    <Grid small={2} large={3}>
      <ContentWrapper>
        <Icon src={iconQuality} variant="large" class="feature-icon" />
        <Heading tag="h3" variant="h5">Quality and Integrity</Heading>
        <Paragraph>
          Careful work and honest communication.
        </Paragraph>
      </ContentWrapper>
      <ContentWrapper>
        <Icon src={iconTree} variant="large" class="feature-icon" />
        <Heading tag="h3" variant="h5">Local Wood</Heading>
        <Paragraph>
          Lumber from trees grown and milled here in Western North
          Carolina, bought from local sawmills, so the work supports the
          community too.
        </Paragraph>
      </ContentWrapper>
      <ContentWrapper>
        <Icon src={iconLeaf} variant="large" class="feature-icon" />
        <Heading tag="h3" variant="h5">Safe Finishes</Heading>
        <Paragraph>
          For each job we choose the safest, most eco-friendly finish
          that suits it, sourced locally where we can.
        </Paragraph>
      </ContentWrapper>
    </Grid>
  </Section>

  <!-- Area -->
  <Section class="section-alt">
    <ContentWrapper variant="columns">
      <Heading tag="h2" maxWidth={24}>Based in Black Mountain</Heading>
      <div slot="column2" class="about-area">
        <Paragraph variant="large">We build for homes in and around:</Paragraph>
        <TownList />
        <Paragraph>
          Somewhere else nearby? Give us a call.
        </Paragraph>
      </div>
    </ContentWrapper>
  </Section>
</Layout>

<style is:global>
  .about-area {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
</style>
