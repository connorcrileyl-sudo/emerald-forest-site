---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Card from "@/components/item/Card.astro";
import Img from "@/components/media/Img.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import QuoteCard from "@/components/content/QuoteCard.astro";
import spiralAbove from "@/assets/images/spiral-staircase-from-above.jpg";
import spiralTreads from "@/assets/images/spiral-staircase-hammered-treads.jpg";
import spiralBalusters from "@/assets/images/spiral-staircase-walnut-balusters.jpg";
import oakStair from "@/assets/images/oak-straight-staircase.jpg";
import oakNewel from "@/assets/images/oak-stair-newel-post.jpg";
import oakRail from "@/assets/images/oak-stair-handrail-detail.jpg";
import { BUSINESS, PHONE_HREF, TOWNS } from "@/consts.ts";
---

<Layout
  title="Spiral & Custom Staircases in Black Mountain, NC"
  description="Handcrafted spiral, curved and straight staircases, stair railings and newel posts in solid hardwood, built in Black Mountain, NC for Asheville-area homes."
>
  <!-- Hero -->
  <Section paddingTop="navoverlap" paddingBottom="large">
    <ContentWrapper variant="columns">
      <Heading tag="h1" variant="h1" maxWidth={16}>
        Spiral and Custom Staircases in Black Mountain, NC
      </Heading>
      <Paragraph variant="large" maxWidth={36}>
        A staircase is the piece of woodwork you use every day. We design
        and build spiral, curved and straight stairs, with handrails,
        balusters and newel posts made to match, for homes around
        Asheville and the Swannanoa Valley.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href={PHONE_HREF}>Call Now</Button>
        <Button element="link" href="/contact/" emphasis="secondary">Free Estimate</Button>
      </ButtonWrapper>
      <Img
        slot="column2"
        src={spiralBalusters}
        alt="Walnut spiral staircase with turned balusters and a curved handrail rising past an orange wall"
        loading="eager"
        fetchPriority="high"
      />
    </ContentWrapper>
  </Section>

  <!-- What we build -->
  <Section class="section-alt">
    <ContentWrapper variant="columns" reverse>
      <Heading tag="h2" maxWidth={16}>
        Spiral Staircases That Fit the Room, Not a Kit
      </Heading>
      <RichText maxWidth={60}>
        <p>
          Spiral stairs save floor space and become the centerpiece of a
          room. Ours are built to the exact height and diameter of your
          opening, with each tread, baluster and section of handrail made
          in the shop.
        </p>
        <p>
          The staircase in these photos combines a walnut handrail and
          turned balusters with hammered metal treads. We can work in the
          hardwood and details that suit your home.
        </p>
        <p>
          TODO (Noah): what materials and tread options you offer, and
          anything about code compliance or inspections clients should know.
        </p>
      </RichText>
      <Img
        slot="column2"
        src={spiralTreads}
        alt="Hammered metal treads on a spiral staircase, framed by walnut balusters"
      />
    </ContentWrapper>
  </Section>

  <Section>
    <ContentWrapper variant="columns">
      <Heading tag="h2" maxWidth={16}>
        Straight Staircases, Stair Railings and Newel Posts
      </Heading>
      <RichText maxWidth={60}>
        <p>
          For a straight run, we build solid hardwood treads and risers
          with handrails, balusters and newel posts shaped by hand. The
          oak staircase shown here has a chamfered newel post and a
          rounded handrail.
        </p>
        <p>
          We can build a complete new staircase, or new rails and posts for
          an existing one.
        </p>
      </RichText>
      <Img
        slot="column2"
        src={oakStair}
        alt="Straight oak staircase with solid treads and a hand-shaped oak handrail, seen from the bottom"
      />
    </ContentWrapper>
  </Section>

  <!-- Gallery -->
  <Section class="section-alt">
    <ContentWrapper>
      <Heading tag="h2" maxWidth={16}>Recent Staircases</Heading>
    </ContentWrapper>
    <Grid xsmall={2} large={3}>
      <Card
        variant="stacked"
        image={spiralAbove}
        imageAlt="Spiral staircase seen from above, treads radiating from a central walnut post"
      />
      <Card
        variant="stacked"
        image={spiralTreads}
        imageAlt="Looking down a spiral staircase with hammered treads and walnut rail"
      />
      <Card
        variant="stacked"
        image={spiralBalusters}
        imageAlt="Turned walnut balusters on a curved spiral staircase"
      />
      <Card
        variant="stacked"
        image={oakStair}
        imageAlt="Oak straight staircase with handrail along a painted mural wall"
      />
      <Card
        variant="stacked"
        image={oakNewel}
        imageAlt="Close-up of a chamfered oak newel post and balusters"
      />
      <Card
        variant="stacked"
        image={oakRail}
        imageAlt="Oak handrail joining a newel post at the foot of a staircase"
      />
    </Grid>
  </Section>

  <!-- Review -->
  <Section>
    <ContentWrapper>
      <Heading tag="h2" maxWidth={16}>From a Recent Client</Heading>
    </ContentWrapper>
    <Grid medium={2}>
      <QuoteCard
        quote="Noah has excellent attention to detail and communication. He offered insights and solutions into some of the complications of our projects executed the vision perfectly. The price was great given the quality provided."
        name="Mike W"
        detail="Google review"
        rating={5}
      />
      <QuoteCard
        quote="Working with Emerald Forest was a pleasure. Excellent communication and workmanship. Great eye for detail aesthetic."
        name="Brandon Greenstein"
        detail="Google review"
        rating={5}
      />
    </Grid>
  </Section>

  <!-- FAQ -->
  <Section class="section-alt">
    <ContentWrapper variant="sticky-content">
      <Heading tag="h2" maxWidth={14}>Staircase Questions</Heading>
      <Paragraph maxWidth={30}>
        Something else? <a href="/contact/">Get in touch</a>.
      </Paragraph>
      <Accordion slot="column2" single>
        <AccordionItem heading="Where do you build staircases?">
          <Paragraph>
            Our shop is in Black Mountain, and we build and install
            staircases in {TOWNS.slice(0, -1).join(", ")} and{" "}
            {TOWNS.at(-1)}, NC, and nearby.
          </Paragraph>
        </AccordionItem>
        <AccordionItem heading="What wood do you use?">
          <Paragraph>
            We use hardwood grown and milled in Western North Carolina,
            bought from local sawmills, finished with a zero-VOC hard wax
            oil.
          </Paragraph>
        </AccordionItem>
        <AccordionItem heading="How do I get an estimate?">
          <Paragraph>
            Call {BUSINESS.phone}, or send the floor-to-floor height, the
            space you have, and a few photos through the{" "}
            <a href="/contact/">contact page</a>.
          </Paragraph>
        </AccordionItem>
        <AccordionItem heading="How long does a custom staircase take?">
          <Paragraph>
            TODO (Noah): a typical time from go-ahead to installation.
          </Paragraph>
        </AccordionItem>
      </Accordion>
    </ContentWrapper>
  </Section>

  <!-- Call to action -->
  <Section theme="brand" paddingTop="small" paddingBottom="small">
    <ContentWrapper variant="auto-width">
      <Heading tag="h2" maxWidth={18}>Planning a New Staircase?</Heading>
      <Paragraph slot="column2" maxWidth={32}>
        Call Noah to talk through the space, or send photos and
        measurements for an estimate.
      </Paragraph>
      <ButtonWrapper slot="column2" marginTop="4">
        <Button element="link" href={PHONE_HREF}>Call Now</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
