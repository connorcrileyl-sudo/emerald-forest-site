---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Card from "@/components/item/Card.astro";
import Img from "@/components/media/Img.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import RelatedServices from "@/components/content/RelatedServices.astro";
import ServiceSchema from "@/components/content/ServiceSchema.astro";
import spiralAbove from "@/assets/images/spiral-staircase-from-above.jpg";
import spiralTreads from "@/assets/images/spiral-staircase-hammered-treads.jpg";
import spiralBalusters from "@/assets/images/spiral-staircase-walnut-balusters.jpg";
import oakStair from "@/assets/images/oak-straight-staircase.jpg";
import oakNewel from "@/assets/images/oak-stair-newel-post.jpg";
import oakRail from "@/assets/images/oak-stair-handrail-detail.jpg";
import { PHONE_HREF } from "@/consts.ts";
import { TOWN_LIST, visibleFaqs, type FaqItem } from "@/utils/faq.ts";

const description =
  "Handcrafted spiral, curved and straight hardwood staircases, designed and built in Black Mountain, NC for homes in Asheville and the Swannanoa Valley.";

const faqs: FaqItem[] = [
  {
    question: "Where do you build staircases?",
    answer: `Our shop is in Black Mountain, and we build and install
      staircases in ${TOWN_LIST}, NC, and nearby.`,
  },
  {
    question: "What wood do you use?",
    answer: `Hardwood grown and milled in Western North Carolina, usually walnut or oak.`,
  },
  {
    question: "How much does a custom staircase cost?",
    answer: `It depends on the type of stair (spiral, curved or straight), the wood, the height and the railings, so every job gets its own free estimate.`,
  },
];
---

<Layout
  title="Spiral & Custom Staircases in Black Mountain & Asheville"
  description={description}
>
  <ServiceSchema
    slot="head"
    name="Spiral and Custom Staircases"
    serviceType="Custom staircases"
    description={description}
    image={spiralBalusters}
    faqs={faqs}
  />

  <!-- Hero -->
  <Section paddingTop="navoverlap" class="section-glow-center" paddingBottom="large">
    <ContentWrapper variant="columns">
      <Heading tag="h1" variant="h1" maxWidth={16}>
        Spiral and Custom Staircases in Black Mountain, NC
      </Heading>
      <Paragraph variant="large" maxWidth={36}>
        We design and build <strong>spiral, curved and straight
        staircases</strong> in our Black Mountain shop for homes around Asheville and the Swannanoa Valley.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href={PHONE_HREF}>Call Now</Button>
        <Button element="link" href="/contact/" emphasis="secondary">Free Estimate</Button>
      </ButtonWrapper>
      <Img
        zoom
        slot="column2"
        src={spiralBalusters}
        alt="Walnut spiral staircase with turned balusters and a curved handrail rising past an orange wall"
        loading="eager"
        fetchPriority="high"
        sizes="(min-width: 90rem) 42rem, (min-width: 64rem) 46vw, 100vw"
      />
    </ContentWrapper>
  </Section>

  <!-- What we build -->
  <Section class="section-alt">
    <ContentWrapper variant="columns" reverse>
      <Heading tag="h2" maxWidth={24}>
        Custom Spiral Staircases
      </Heading>
      <RichText maxWidth={54}>
        <p>
          A spiral staircase takes far less floor space than a straight run. Ours are built to the height and diameter of your opening, with the wood treads, balusters and handrail made in our Black Mountain shop. Stairs have to be right to a fraction of an inch, so we take our time measuring and check the details with you first.
        </p>
        <p>
          Treads can be wood or metal, with a curved handrail and turned balusters in walnut, oak or another local hardwood.
        </p>
      </RichText>
      <Img
        zoom
        slot="column2"
        src={spiralTreads}
        alt="Hammered metal treads on a spiral staircase, framed by walnut balusters"
      />
    </ContentWrapper>
  </Section>

  <Section>
    <ContentWrapper variant="columns">
      <Heading tag="h2" maxWidth={24}>
        Straight Hardwood Staircases
      </Heading>
      <RichText maxWidth={54}>
        <p>
          For a straight run, we build solid hardwood treads and risers
          with handrails, balusters and newel posts shaped by hand.
        </p>
        <p>
          Only need a new railing for the stairs you have? See{" "}
          <a href="/stair-railings/">stair railings</a>.
        </p>
      </RichText>
      <Img
        zoom
        slot="column2"
        src={oakStair}
        alt="Straight oak staircase with solid treads and a hand-shaped oak handrail, seen from the bottom"
      />
    </ContentWrapper>
  </Section>

  <!-- Gallery -->
  <Section class="section-alt">
    <ContentWrapper>
      <Heading tag="h2" maxWidth={24}>Recent Staircases</Heading>
    </ContentWrapper>
    <Grid xsmall={2} large={3}>
      <Card
        variant="stacked"
        image={spiralAbove}
        imageAlt="Spiral staircase seen from above, treads radiating from a central walnut post"
      />
      <Card
        variant="stacked"
        image={spiralTreads}
        imageAlt="Looking down a spiral staircase with hammered treads and walnut rail"
      />
      <Card
        variant="stacked"
        image={spiralBalusters}
        imageAlt="Turned walnut balusters on a curved spiral staircase"
      />
      <Card
        variant="stacked"
        image={oakStair}
        imageAlt="Oak straight staircase with handrail along a painted mural wall"
      />
      <Card
        variant="stacked"
        image={oakNewel}
        imageAlt="Close-up of a chamfered oak newel post and balusters"
      />
      <Card
        variant="stacked"
        image={oakRail}
        imageAlt="Oak handrail joining a newel post at the foot of a staircase"
      />
    </Grid>
  </Section>


  <!-- FAQ -->
  <Section>
    <ContentWrapper variant="sticky-content">
      <Heading tag="h2" maxWidth={24}>Staircase Questions</Heading>
      <Paragraph maxWidth={30}>
        Something else? <a href="/contact/">Get in touch</a>.
      </Paragraph>
      <Accordion slot="column2" single>
        {visibleFaqs(faqs).map((faq) => (
          <AccordionItem heading={faq.question}>
            <Paragraph set:html={faq.answer} />
          </AccordionItem>
        ))}
      </Accordion>
    </ContentWrapper>
  </Section>

  <RelatedServices current="/custom-staircases/" />
</Layout>
