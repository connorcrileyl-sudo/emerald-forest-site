---
/*
 * Terms of service for the website. Deliberately says nothing about
 * deposits, payment schedules or warranty length: Noah hasn't given
 * those, and each project's written estimate/agreement sets them.
 */
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import BreadcrumbSchema from "@/components/content/BreadcrumbSchema.astro";
import { BUSINESS, PHONE_HREF, SITE_NAME } from "@/consts.ts";

const EFFECTIVE = "November 18, 2026";
---

<Layout
  title="Terms of Service"
  description={`The terms for using the ${SITE_NAME} website and how quotes and projects work.`}
>
  <BreadcrumbSchema slot="head" trail={[{ label: "Terms of Service", href: "/terms/" }]} />
  <Section paddingTop="navoverlap" class="section-glow-center">
    <div class="legal">
      <Heading tag="h1" variant="h2">Terms of Service</Heading>
      <Paragraph variant="small">Effective {EFFECTIVE}</Paragraph>
      <RichText maxWidth={54}>
        <p>
          These terms cover your use of the {SITE_NAME} website. By using
          the site, you agree to them. "We" and "us" mean {SITE_NAME},
          based in Black Mountain, North Carolina.
        </p>

        <h2>About the information on this site</h2>
        <p>
          We describe our work, materials and services as accurately as we
          can, but the site is for general information. Nothing on it is
          a quote, an offer or a guarantee of price, timing or
          availability. Every piece we build is made to order, so details
          are always agreed with you directly.
        </p>

        <h2>Estimates and projects</h2>
        <p>
          There are no cookie-cutter solutions in this kind of work. Every
          home, staircase and piece of furniture is different, and each
          one takes real thought and care to get right. So every job is
          priced on its own, with a free estimate.
        </p>
        <p>
          We're always open to talking things through: your ideas, the
          wood, the design, the budget, or anything you're unsure about.
          The price, scope, schedule, payment terms and any warranty for
          your project are worked out with you for that project. If an
          estimate or agreement we give you differs from these terms or
          from the website, the estimate or agreement wins.
        </p>
        <p>
          We work with natural wood. Grain, color and figure vary from
          board to board and change gently with age and light, and solid
          wood moves a little with the seasons. Photos on this site show
          past projects; your piece will have its own character.
        </p>

        <h2>Photos and content</h2>
        <p>
          The photos, text and designs on this site belong to {SITE_NAME}{" "}
          unless noted otherwise. You are welcome to share links to our
          pages. Please don't copy, reuse or sell our photos or content
          without asking us first.
        </p>
        <p>
          If you send us photos or plans of your home or project, you
          keep ownership of them. You allow us to use them to quote and
          do your work. We'll only show photos of finished work in your
          home on our site or social media with your permission.
        </p>

        <h2>Using the site</h2>
        <p>
          Please don't misuse the site, for example by sending spam
          through the contact form, trying to break or overload it, or
          using it for anything unlawful.
        </p>

        <h2>Links to other sites</h2>
        <p>
          The site links to other websites, such as Google, Facebook and
          Instagram. We don't control those sites and aren't responsible
          for their content or how they handle your information.
        </p>

        <h2>Privacy</h2>
        <p>
          How we handle the information you send us is explained in our{" "}
          <a href="/privacy-policy/">Privacy Policy</a>.
        </p>

        <h2>No warranties for the website</h2>
        <p>
          We do our best to keep the site accurate and working, but it is
          provided "as is." We can't promise it will always be available
          or free of errors. This doesn't affect any warranty in your
          written estimate or agreement for work we do.
        </p>

        <h2>Limitation of liability</h2>
        <p>
          As far as the law allows, we are not liable for any loss or
          damage that comes from using this website or relying on its
          general information. Nothing in these terms limits any rights
          you have under North Carolina law that can't be limited.
        </p>

        <h2>Governing law</h2>
        <p>
          These terms are governed by the laws of the State of North
          Carolina. Any dispute about them will be handled in the courts
          of Buncombe County, North Carolina.
        </p>

        <h2>Changes to these terms</h2>
        <p>
          We may update these terms from time to time. Changes take
          effect when they are posted here, and the date at the top will
          change.
        </p>

        <h2>Contact us</h2>
        <p>
          Questions about these terms? Call{" "}
          <a href={PHONE_HREF}>{BUSINESS.phone}</a> or email{" "}
          <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>.
        </p>
      </RichText>
    </div>
  </Section>
</Layout>
