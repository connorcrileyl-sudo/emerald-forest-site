---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import Card from "@/components/item/Card.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import RelatedServices from "@/components/content/RelatedServices.astro";
import ServiceSchema from "@/components/content/ServiceSchema.astro";
import mapleKitchen from "@/assets/images/maple-kitchen-cabinets-wide.jpg";
import kitchenDrawers from "@/assets/images/kitchen-cabinets-wood-drawers.jpg";
import kitchenSink from "@/assets/images/kitchen-cabinets-copper-sink.jpg";
import drawerBank from "@/assets/images/maple-kitchen-drawer-bank.jpg";
import kitchenStone from "@/assets/images/kitchen-cabinets-stone-wall.jpg";
import plateShelves from "@/assets/images/painted-kitchen-plate-shelves.jpg";
import { PHONE_HREF } from "@/consts.ts";
import { TOWN_LIST, visibleFaqs, type FaqItem } from "@/utils/faq.ts";

const description =
  "Custom kitchens, solid hardwood kitchen cabinets and countertops, made in Black Mountain, NC and installed in homes across the Asheville area.";

const faqs: FaqItem[] = [
  {
    question: "Where do you build kitchens?",
    answer: `Kitchen cabinets are made in our Black Mountain shop and
      installed in homes in ${TOWN_LIST}, NC, and nearby.`,
  },
  {
    question: "Is the finish safe in a kitchen?",
    answer: `Yes. We pick the safest, most eco-friendly finish that
      suits the job, and food-safe ones wherever food is involved.`,
  },
  {
    question: "How much does a custom kitchen cost?",
    answer: `It depends on the size of the kitchen, the wood, the door
      style and the installation, so every job gets its own free
      estimate.`,
  },
];
---

<Layout
  title="Custom Kitchens in Black Mountain & Asheville, NC"
  description={description}
>
  <ServiceSchema
    slot="head"
    name="Custom Kitchens and Kitchen Cabinets"
    serviceType="Custom kitchen cabinets"
    description={description}
    image={mapleKitchen}
    faqs={faqs}
  />

  <!-- Hero -->
  <Section paddingTop="navoverlap" class="section-glow-center" paddingBottom="large">
    <ContentWrapper variant="columns" class="hero-photo-square">
      <Heading tag="h1" variant="h1" maxWidth={16}>
        Custom Kitchens in Black Mountain, NC
      </Heading>
      <Paragraph variant="large" maxWidth={36}>
        Solid hardwood kitchens, made in our
        Black Mountain shop for homes around Asheville.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href={PHONE_HREF}>Call Now</Button>
        <Button element="link" href="/contact/" emphasis="secondary">Free Estimate</Button>
      </ButtonWrapper>
      <Img
        zoom
        slot="column2"
        src={mapleKitchen}
        alt="Maple kitchen with slab-front cabinets, a stainless range, green tile backsplash and a window over the counter"
        loading="eager"
        fetchPriority="high"
        sizes="(min-width: 90rem) 42rem, (min-width: 64rem) 46vw, 100vw"
      />
    </ContentWrapper>
  </Section>

  <!-- Full kitchens -->
  <Section class="section-alt">
    <ContentWrapper variant="columns" reverse>
      <Heading tag="h2" maxWidth={24}>Full Kitchen Build-Outs</Heading>
      <RichText maxWidth={54}>
        <p>
          Solid hardwood cabinets and countertops, made to measure, even in older homes where nothing is quite square. We measure carefully and talk through how you use your kitchen before anything is cut.
        </p>
      </RichText>
      <Img
        zoom
        slot="column2"
        src={kitchenSink}
        alt="Wood kitchen cabinets with a hammered copper farmhouse sink and stone countertop"
      />
    </ContentWrapper>
  </Section>

  <!-- Cabinets, drawers and shelving -->
  <Section>
    <ContentWrapper variant="columns">
      <Heading tag="h2" maxWidth={24}>
        Kitchen Cabinets, Drawers and Open Shelving
      </Heading>
      <RichText maxWidth={54}>
        <p>
          Natural wood or painted, with drawers and open shelves where
          you want them.
        </p>
        <p>
          Built-ins elsewhere in the house? See{" "}
          <a href="/custom-cabinets/">cabinets and built-ins</a>.
        </p>
      </RichText>
      <Img
        zoom
        slot="column2"
        src={plateShelves}
        alt="Painted open shelves with plate rails holding orange plates, beside a stone wall"
      />
    </ContentWrapper>
  </Section>

  <!-- Gallery -->
  <Section class="section-alt">
    <ContentWrapper>
      <Heading tag="h2" maxWidth={24}>Recent Kitchens</Heading>
    </ContentWrapper>
    <Grid xsmall={2} large={3} class="photo-cards">
      <Card
        variant="stacked"
        image={kitchenDrawers}
        imageAlt="Solid wood kitchen cabinets and drawers with slim metal pulls, built around a gas range"
      />
      <Card
        variant="stacked"
        image={drawerBank}
        imageAlt="Bank of maple drawers with recessed pulls and figured grain on the drawer fronts"
      />
      <Card
        variant="stacked"
        image={kitchenStone}
        imageAlt="L-shaped kitchen cabinets with a dark wood countertop below a stone wall, open shelves and a window"
      />
    </Grid>
    <ContentWrapper>
      <ButtonWrapper>
        <Button element="link" href="/portfolio/" emphasis="secondary">See More of Our Work</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <!-- FAQ -->
  <Section>
    <ContentWrapper variant="sticky-content">
      <Heading tag="h2" maxWidth={24}>Kitchen Questions</Heading>
      <Paragraph maxWidth={30}>
        Something else? <a href="/contact/">Get in touch</a>.
      </Paragraph>
      <Accordion slot="column2" single>
        {visibleFaqs(faqs).map((faq) => (
          <AccordionItem heading={faq.question}>
            <Paragraph set:html={faq.answer} />
          </AccordionItem>
        ))}
      </Accordion>
    </ContentWrapper>
  </Section>

  <RelatedServices current="/custom-kitchens/" />
</Layout>
