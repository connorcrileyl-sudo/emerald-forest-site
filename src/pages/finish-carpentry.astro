---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import RelatedServices from "@/components/content/RelatedServices.astro";
import ServiceSchema from "@/components/content/ServiceSchema.astro";
import archedTrim from "@/assets/images/arched-door-with-trim.jpg";
/* Stock photos (Envato): close-ups of the work in general, not Noah. */
import crownMolding from "@/assets/images/stock-crown-molding-nail-gun.jpg";
import archedWindow from "@/assets/images/arched-window-trim.jpg";
import { PHONE_HREF } from "@/consts.ts";
import { TOWN_LIST, visibleFaqs, type FaqItem } from "@/utils/faq.ts";

const description =
  "Crown molding, wainscoting, coffered ceilings, trim, baseboards and interior doors by a Black Mountain, NC finish carpenter serving the Asheville area.";

const faqs: FaqItem[] = [
  {
    question: "Can you match trim that's already in my house?",
    answer: `Yes. Send a photo of the existing trim and we'll match it.`,
  },
  {
    question: "Do you take on trim work outside Black Mountain?",
    answer: `Yes. We fit trim, molding and interior doors in homes in
      ${TOWN_LIST}, NC, and nearby.`,
  },
  {
    question: "How much does trim or finish carpentry cost?",
    answer: `It depends on how many rooms, the trim profiles, and whether existing trim needs matching, so every job gets its own free estimate.`,
  },
];
---

<Layout
  title="Trim & Finish Carpentry in Black Mountain & Asheville, NC"
  description={description}
>
  <ServiceSchema
    slot="head"
    name="Trim and Finish Carpentry"
    serviceType="Finish carpentry"
    description={description}
    image={archedTrim}
    faqs={faqs}
  />

  <!-- Hero -->
  <Section paddingTop="navoverlap" class="section-glow-center" paddingBottom="large">
    <ContentWrapper variant="columns" class="hero-photo-square">
      <Heading tag="h1" variant="h1" maxWidth={16}>
        Trim and Finish Carpentry in Black Mountain, NC
      </Heading>
      <Paragraph variant="large" maxWidth={36}>
        We fit crown molding, wainscoting, coffered ceilings and trim by
        hand in homes around Black Mountain and Asheville.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href={PHONE_HREF}>Call Now</Button>
        <Button element="link" href="/contact/" emphasis="secondary">Free Estimate</Button>
      </ButtonWrapper>
      <Img
        zoom
        slot="column2"
        src={archedTrim}
        alt="Arched solid wood door framed by matching curved wood trim"
        loading="eager"
        fetchPriority="high"
        sizes="(min-width: 90rem) 42rem, (min-width: 64rem) 46vw, 100vw"
      />
    </ContentWrapper>
  </Section>

  <!-- Molding and wall paneling -->
  <Section class="section-alt">
    <ContentWrapper variant="columns" reverse>
      <Heading tag="h2" maxWidth={24}>
        Crown Molding, Wainscoting and Coffered Ceilings
      </Heading>
      <RichText maxWidth={54}>
        <p>
          We install crown molding, wainscoting and wall paneling, and
          build coffered ceilings. Older homes rarely have square walls or
          level ceilings, so each piece is scribed and fitted on site. We take our time on the joints and corners, so the trim looks like it was always there.
        </p>
        <p>
          Built-in bookshelves or cabinets for the same room? See{" "}
          <a href="/custom-cabinets/">custom cabinets and built-ins</a>.
        </p>
      </RichText>
      <Img
        zoom
        slot="column2"
        src={crownMolding}
        alt="Close-up of white crown molding being nailed in where the wall meets the ceiling"
      />
    </ContentWrapper>
  </Section>

  <!-- Trim and doors -->
  <Section>
    <ContentWrapper variant="columns">
      <Heading tag="h2" maxWidth={24}>
        Window and Door Trim, Baseboards and Interior Doors
      </Heading>
      <RichText maxWidth={54}>
        <p>
          We fit window and door casings, baseboards and interior doors,
          including curved trim for arched doors and windows. Trim can be made to match what's already in the house.
        </p>
        <p>
          Need the doors themselves made? See{" "}
          <a href="/custom-doors/">custom solid wood doors</a>.
        </p>
      </RichText>
      <Img
        zoom
        slot="column2"
        src={archedWindow}
        alt="Curved wood trim framing a half-round arched window"
      />
    </ContentWrapper>
  </Section>

  <!-- FAQ -->
  <Section class="section-alt">
    <ContentWrapper variant="sticky-content">
      <Heading tag="h2" maxWidth={24}>Finish Carpentry Questions</Heading>
      <Paragraph maxWidth={30}>
        Something else? <a href="/contact/">Get in touch</a>.
      </Paragraph>
      <Accordion slot="column2" single>
        {visibleFaqs(faqs).map((faq) => (
          <AccordionItem heading={faq.question}>
            <Paragraph set:html={faq.answer} />
          </AccordionItem>
        ))}
      </Accordion>
    </ContentWrapper>
  </Section>

  <RelatedServices current="/finish-carpentry/" />
</Layout>
