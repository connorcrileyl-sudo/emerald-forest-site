---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import RelatedServices from "@/components/content/RelatedServices.astro";
import ServiceSchema from "@/components/content/ServiceSchema.astro";
import oakRail from "@/assets/images/oak-stair-handrail-detail.jpg";
import oakNewel from "@/assets/images/oak-stair-newel-post.jpg";
import spiralBalusters from "@/assets/images/spiral-staircase-walnut-balusters.jpg";
import { BUSINESS, PHONE_HREF } from "@/consts.ts";
import { TOWN_LIST, visibleFaqs, type FaqItem } from "@/utils/faq.ts";

const description =
  "Custom wood stair railings, handrails, balusters and newel posts, made by hand for new or existing stairs by a Black Mountain, NC carpenter.";

const faqs: FaqItem[] = [
  {
    question: "Can you replace just the railing, not the stairs?",
    answer: `Yes. We make new handrails, balusters and newel posts for
      existing stairs.`,
  },
  {
    question: "Can you fix a loose or wobbly railing?",
    answer: `Yes. Loose railings and newel posts can usually be tightened
      or re-secured; if a part is cracked or rotten, we make a new one
      to match.`,
  },
  {
    question: "What wood are the railings made from?",
    answer: `Solid hardwood. The straight railing on this page is oak,
      and the curved spiral railing is walnut.`,
  },
  {
    question: "Do you fit railings outside Black Mountain?",
    answer: `Yes. Railings are made in our Black Mountain shop and fitted
      to stairs in homes in ${TOWN_LIST}, NC, and nearby.`,
  },
  {
    question: "How much does a new stair railing cost?",
    answer: `It depends on the length of the railing, the wood, and the balusters and newel posts. Give us a call or
      send a few photos, and we'll gladly put together a free estimate.`,
  },
  {
    question: "How do I get an estimate?",
    answer: `Call ${BUSINESS.phone}, or send photos of the stairs and the
      railing you have now through the
      <a href="/contact/">contact page</a>.`,
  },
];
---

<Layout
  title="Wood Stair Railings & Newel Posts | Black Mountain & Asheville, NC"
  description={description}
>
  <ServiceSchema
    slot="head"
    name="Wood Stair Railings and Newel Posts"
    serviceType="Stair railings and newel posts"
    description={description}
    image={oakRail}
    faqs={faqs}
  />

  <!-- Hero -->
  <Section paddingTop="navoverlap" class="section-glow-center" paddingBottom="large">
    <ContentWrapper variant="columns">
      <Heading tag="h1" variant="h1" maxWidth={16}>
        Wood Stair Railings and Newel Posts in Black Mountain, NC
      </Heading>
      <Paragraph variant="large" maxWidth={36}>
        We shape wood stair railings, balusters and newel posts by hand
        in our Black Mountain shop, and fit them to new staircases or
        the stairs already in homes around Asheville.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href={PHONE_HREF}>Call Now</Button>
        <Button element="link" href="/contact/" emphasis="secondary">Free Estimate</Button>
      </ButtonWrapper>
      <Img
        slot="column2"
        src={oakRail}
        alt="Close-up of a hand-shaped oak stair handrail"
        loading="eager"
        fetchPriority="high"
      />
    </ContentWrapper>
  </Section>

  <!-- Existing stairs -->
  <Section class="section-alt">
    <ContentWrapper variant="columns" reverse>
      <Heading tag="h2" maxWidth={24}>New Railings for Existing Stairs</Heading>
      <RichText maxWidth={60}>
        <p>
          You don't need a new staircase to get a new railing. We make and
          fit new handrails, balusters and newel posts for stairs that are
          already in place, and we tighten or replace loose railings.
        </p>
        <p>
          The oak railing shown here has a chamfered newel post and a
          rounded handrail, all shaped by hand.
        </p>
      </RichText>
      <Img
        slot="column2"
        src={oakNewel}
        alt="Chamfered oak newel post at the foot of a straight staircase"
      />
    </ContentWrapper>
  </Section>

  <!-- Spiral and curved -->
  <Section>
    <ContentWrapper variant="columns">
      <Heading tag="h2" maxWidth={24}>Curved Rails and Turned Balusters</Heading>
      <RichText maxWidth={60}>
        <p>
          Curved and spiral stairs need a handrail that follows the curve
          and balusters to match. The walnut spiral staircase here has a
          curved handrail and turned balusters made in our shop.
        </p>
        <p>
          Building the whole staircase? See{" "}
          <a href="/custom-staircases/">spiral and custom staircases</a>.
        </p>
      </RichText>
      <Img
        slot="column2"
        src={spiralBalusters}
        alt="Walnut spiral staircase with turned balusters and a curved handrail"
      />
    </ContentWrapper>
  </Section>

  <!-- FAQ -->
  <Section class="section-alt">
    <ContentWrapper variant="sticky-content">
      <Heading tag="h2" maxWidth={14}>Railing Questions</Heading>
      <Paragraph maxWidth={30}>
        Something else? <a href="/contact/">Get in touch</a>.
      </Paragraph>
      <Accordion slot="column2" single>
        {visibleFaqs(faqs).map((faq) => (
          <AccordionItem heading={faq.question}>
            <Paragraph set:html={faq.answer} />
          </AccordionItem>
        ))}
      </Accordion>
    </ContentWrapper>
  </Section>

  <RelatedServices current="/stair-railings/" />
</Layout>
