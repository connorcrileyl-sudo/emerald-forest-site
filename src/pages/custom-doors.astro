---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Card from "@/components/item/Card.astro";
import Img from "@/components/media/Img.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import RelatedServices from "@/components/content/RelatedServices.astro";
import ServiceSchema from "@/components/content/ServiceSchema.astro";
import carvedPanel from "@/assets/images/walnut-door-carved-panel.jpg";
import entryInstalled from "@/assets/images/walnut-entry-door-installed.jpg";
import entryOpen from "@/assets/images/walnut-entry-door-open.jpg";
import arched from "@/assets/images/arched-hardwood-door.jpg";
import archedTrim from "@/assets/images/arched-door-with-trim.jpg";
import plankDoors from "@/assets/images/plank-interior-doors.jpg";
import finishing from "@/assets/images/finishing-a-walnut-door.jpg";
import { PHONE_HREF } from "@/consts.ts";
import { TOWN_LIST, visibleFaqs, type FaqItem } from "@/utils/faq.ts";

const description =
  "Custom solid wood entry doors, arched doors, interior doors and sliding barn doors, handmade in Black Mountain, NC for homes in Asheville, Swannanoa and Montreat.";

const faqs: FaqItem[] = [
  {
    question: "Where do you make and install doors?",
    answer: `Doors are built in our Black Mountain shop for homes in
      ${TOWN_LIST}, NC, and nearby.`,
  },
  {
    question: "What wood and finish do you use?",
    answer: `Hardwood grown and milled in Western North Carolina,
      with food-safe, eco-friendly finishes.`,
  },
  {
    question: "How much does a custom wood door cost?",
    answer: `It depends on the size, the wood, the design and whether it's an entry or interior door, so every job gets its own free estimate.`,
  },
];
---

<Layout
  title="Custom Solid Wood Doors | Black Mountain & Asheville, NC"
  description={description}
>
  <ServiceSchema
    slot="head"
    name="Custom Solid Wood Doors"
    serviceType="Solid hardwood doors"
    description={description}
    image={entryInstalled}
    faqs={faqs}
  />

  <!-- Hero -->
  <Section paddingTop="navoverlap" class="section-glow-center" paddingBottom="large">
    <ContentWrapper variant="columns" class="hero-photo-square">
      <Heading tag="h1" variant="h1" maxWidth={16}>
        Custom Solid Wood Doors in Black Mountain, NC
      </Heading>
      <Paragraph variant="large" maxWidth={36}>
        We build solid hardwood entry doors, arched doors and interior
        doors in our Black Mountain shop for homes around Asheville,
        each made to fit its opening exactly and finished by hand.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href={PHONE_HREF}>Call Now</Button>
        <Button element="link" href="/contact/" emphasis="secondary">Free Estimate</Button>
      </ButtonWrapper>
      <Img
        zoom
        slot="column2"
        src={entryInstalled}
        alt="Solid walnut entry door with a carved geometric upper panel and raised lower panels"
        loading="eager"
        fetchPriority="high"
      />
    </ContentWrapper>
  </Section>

  <!-- Entry doors -->
  <Section class="section-alt">
    <ContentWrapper variant="columns" reverse>
      <Heading tag="h2" maxWidth={24}>Solid Wood Front Doors</Heading>
      <RichText maxWidth={60}>
        <p>
          We build entry doors in walnut or another local hardwood,
          with carved, raised or plain panels. We work through the design with you, from the panel layout to the wood, before anything is built.
        </p>
      </RichText>
      <Img
        zoom
        slot="column2"
        src={entryOpen}
        alt="Walnut entry door standing open, showing its full thickness and carved panel"
      />
    </ContentWrapper>
  </Section>

  <!-- Arched and interior -->
  <Section>
    <ContentWrapper variant="columns">
      <Heading tag="h2" maxWidth={24}>
        Arched, Interior and Sliding Barn Doors
      </Heading>
      <RichText maxWidth={60}>
        <p>
          We build arched doors
          with matching curved trim (see{" "}
          <a href="/finish-carpentry/">trim and finish carpentry</a>), and
          plank and panel interior doors in solid hardwood for closets,
          bedrooms and pantries.
        </p>
        <p>
          Solid wood interior doors feel heavier and quieter than hollow
          ones, and can be sanded and refinished rather than replaced.
        </p>
        <p>
          We also build sliding barn doors in solid hardwood, a good fit
          where a swinging door would take up too much room.
        </p>
      </RichText>
      <Img
        zoom
        slot="column2"
        src={archedTrim}
        alt="Arched solid wood door with horizontal planks and a matching curved wood trim"
      />
    </ContentWrapper>
  </Section>

  <!-- Gallery -->
  <Section class="section-alt">
    <ContentWrapper>
      <Heading tag="h2" maxWidth={24}>Recent Doors</Heading>
    </ContentWrapper>
    <Grid xsmall={2} large={3}>
      <Card
        variant="stacked"
        image={carvedPanel}
        imageAlt="Carved walnut door panel with an interlocking geometric pattern"
      />
      <Card
        variant="stacked"
        image={entryInstalled}
        imageAlt="Walnut entry door installed in a new home"
      />
      <Card
        variant="stacked"
        image={arched}
        imageAlt="Arched plank door with a black knob in a white hallway"
      />
      <Card
        variant="stacked"
        image={archedTrim}
        imageAlt="Arched door and curved trim in warm-toned hardwood"
      />
      <Card
        variant="stacked"
        image={plankDoors}
        imageAlt="Two solid wood plank interior doors in a hallway"
      />
      <Card
        variant="stacked"
        image={finishing}
        imageAlt="Noah applying finish to a walnut door laid flat in the shop"
      />
    </Grid>
  </Section>


  <!-- FAQ -->
  <Section>
    <ContentWrapper variant="sticky-content">
      <Heading tag="h2" maxWidth={24}>Door Questions</Heading>
      <Paragraph maxWidth={30}>
        Something else? <a href="/contact/">Get in touch</a>.
      </Paragraph>
      <Accordion slot="column2" single>
        {visibleFaqs(faqs).map((faq) => (
          <AccordionItem heading={faq.question}>
            <Paragraph set:html={faq.answer} />
          </AccordionItem>
        ))}
      </Accordion>
    </ContentWrapper>
  </Section>

  <RelatedServices current="/custom-doors/" />
</Layout>
