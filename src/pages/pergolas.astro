---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Card from "@/components/item/Card.astro";
import Img from "@/components/media/Img.astro";
import pergolaPlanters from "@/assets/images/pergola-with-planters.jpg";
import pergolaFront from "@/assets/images/pergola-front-view.jpg";
import pergolaUnder from "@/assets/images/pergola-underneath.jpg";
import { PHONE_HREF, TOWNS } from "@/consts.ts";
---

<Layout
  title="Wood Pergolas & Outdoor Structures in Black Mountain, NC"
  description="Custom wood pergolas and outdoor structures built by a Black Mountain, NC carpenter for homes in Asheville, Swannanoa, Montreat and nearby."
>
  <!-- Hero -->
  <Section paddingTop="navoverlap" paddingBottom="large">
    <ContentWrapper variant="columns">
      <Heading tag="h1" variant="h1" maxWidth={16}>
        Wood Pergolas and Outdoor Structures in Black Mountain, NC
      </Heading>
      <Paragraph variant="large" maxWidth={36}>
        Custom pergolas built from solid timber, designed for your yard,
        patio or driveway, and built to the same standard as our indoor
        work.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href={PHONE_HREF}>Call Now</Button>
        <Button element="link" href="/contact/" emphasis="secondary">Free Estimate</Button>
      </ButtonWrapper>
      <Img
        slot="column2"
        src={pergolaFront}
        alt="Large timber pergola with a slatted roof and planter boxes, against a mountain backdrop"
        loading="eager"
        fetchPriority="high"
      />
    </ContentWrapper>
  </Section>

  <!-- Project -->
  <Section class="section-alt">
    <ContentWrapper variant="columns" reverse>
      <Heading tag="h2" maxWidth={16}>
        A Covered Space with Built-In Planters
      </Heading>
      <RichText maxWidth={60}>
        <p>
          This pergola covers a wide concrete pad, with a slatted roof
          that casts light shade and planter boxes built into both sides.
          It frames the view of the mountains beyond.
        </p>
        <p>
          TODO (Noah): what kinds of outdoor builds you take on (pergolas,
          decks, covered porches, sheds?) and the wood you use outdoors.
        </p>
      </RichText>
      <Img
        slot="column2"
        src={pergolaUnder}
        alt="View from under the pergola, sunlight falling through the roof slats onto the concrete"
      />
    </ContentWrapper>
  </Section>

  <!-- Gallery -->
  <Section>
    <ContentWrapper>
      <Heading tag="h2" maxWidth={16}>The Finished Pergola</Heading>
    </ContentWrapper>
    <Grid xsmall={2} large={3}>
      <Card
        variant="stacked"
        image={pergolaPlanters}
        imageAlt="Side view of the pergola with long planter boxes along its base"
      />
      <Card
        variant="stacked"
        image={pergolaFront}
        imageAlt="Front of the pergola showing its slatted roof and posts"
      />
      <Card
        variant="stacked"
        image={pergolaUnder}
        imageAlt="Under the pergola looking out across the driveway"
      />
    </Grid>
    <Paragraph maxWidth={60}>
      We build outdoor structures for homes in{" "}
      {TOWNS.slice(0, -1).join(", ")} and {TOWNS.at(-1)}, NC.
    </Paragraph>
  </Section>

  <!-- Call to action -->
  <Section theme="brand" paddingTop="small" paddingBottom="small">
    <ContentWrapper variant="auto-width">
      <Heading tag="h2" maxWidth={18}>Planning an Outdoor Project?</Heading>
      <Paragraph slot="column2" maxWidth={32}>
        Call Noah, or send photos of the space and rough measurements for
        an estimate.
      </Paragraph>
      <ButtonWrapper slot="column2" marginTop="4">
        <Button element="link" href={PHONE_HREF}>Call Now</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
