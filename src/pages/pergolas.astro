---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Card from "@/components/item/Card.astro";
import Img from "@/components/media/Img.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import RelatedServices from "@/components/content/RelatedServices.astro";
import ServiceSchema from "@/components/content/ServiceSchema.astro";
import pergolaPlanters from "@/assets/images/pergola-with-planters.jpg";
import pergolaFront from "@/assets/images/pergola-front-view.jpg";
import pergolaUnder from "@/assets/images/pergola-underneath.jpg";
import pergolaShade from "@/assets/images/pergola-dappled-shade.jpg";
import { BUSINESS, PHONE_HREF } from "@/consts.ts";
import { TOWN_LIST, visibleFaqs, type FaqItem } from "@/utils/faq.ts";

const description =
  "Custom wood pergolas and covered outdoor structures, designed and built in solid timber by a Black Mountain, NC carpenter. Serving Asheville and nearby.";

const faqs: FaqItem[] = [
  {
    question: "Where do you build pergolas?",
    answer: `Each pergola is designed for its spot and built at homes in
      ${TOWN_LIST}, NC, and nearby.`,
  },
  {
    question: "Can a pergola have built-in planters or seating?",
    answer: `Yes. The pergola on this page has planter boxes built into
      both sides. Tell us what you'd like the space to do and we'll
      design around it.`,
  },
  {
    question: "How much does a wood pergola cost?",
    answer: `It depends on the size, the roof and any built-ins such as planters or benches. Give us a call or
      send a few photos, and we'll gladly put together a free estimate.`,
  },
  {
    question: "How do I get an estimate?",
    answer: `Call ${BUSINESS.phone}, or send photos of the spot and rough
      measurements through the <a href="/contact/">contact page</a>.`,
  },
];
---

<Layout
  title="Custom Wood Pergolas | Black Mountain & Asheville, NC"
  description={description}
>
  <ServiceSchema
    slot="head"
    name="Custom Wood Pergolas"
    serviceType="Pergolas and outdoor structures"
    description={description}
    image={pergolaFront}
    faqs={faqs}
  />

  <!-- Hero -->
  <Section paddingTop="navoverlap" class="section-glow-center" paddingBottom="large">
    <ContentWrapper variant="columns">
      <Heading tag="h1" variant="h1" maxWidth={16}>
        Custom Wood Pergolas in Black Mountain, NC
      </Heading>
      <Paragraph variant="large" maxWidth={36}>
        We design and build solid timber pergolas and covered outdoor
        spaces for yards, patios and driveways around Black Mountain and
        Asheville, to the same standard as our indoor work.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href={PHONE_HREF}>Call Now</Button>
        <Button element="link" href="/contact/" emphasis="secondary">Free Estimate</Button>
      </ButtonWrapper>
      <Img
        slot="column2"
        src={pergolaShade}
        alt="Under a large timber pergola, sunlight through the slatted roof casting a grid of light across the concrete"
        loading="eager"
        fetchPriority="high"
      />
    </ContentWrapper>
  </Section>

  <!-- Project -->
  <Section class="section-alt">
    <ContentWrapper variant="columns" reverse>
      <Heading tag="h2" maxWidth={24}>
        A Covered Space with Built-In Planters
      </Heading>
      <RichText maxWidth={60}>
        <p>
          This pergola covers a wide concrete pad, with a slatted roof
          that casts light shade and planter boxes built into both sides.
          It frames the view of the mountains beyond.
        </p>
        <p>
          Every pergola is designed for its spot: the size of the space,
          how much shade you want, and what it needs to connect to, from a
          patio or driveway to the side of the house.
        </p>
      </RichText>
      <Img
        slot="column2"
        src={pergolaFront}
        alt="Large timber pergola with a slatted roof and planter boxes, against a mountain backdrop"
      />
    </ContentWrapper>
  </Section>

  <!-- Gallery -->
  <Section>
    <ContentWrapper>
      <Heading tag="h2" maxWidth={24}>The Finished Pergola</Heading>
    </ContentWrapper>
    <Grid xsmall={2} large={3}>
      <Card
        variant="stacked"
        image={pergolaPlanters}
        imageAlt="Side view of the pergola with long planter boxes along its base"
      />
      <Card
        variant="stacked"
        image={pergolaFront}
        imageAlt="Front of the pergola showing its slatted roof and posts"
      />
      <Card
        variant="stacked"
        image={pergolaUnder}
        imageAlt="Under the pergola looking out across the driveway"
      />
    </Grid>
    <Paragraph maxWidth={60}>
      Building a deck to go with it? See{" "}
      <a href="/decks/">decks, deck repair and staining</a>. Porch posts
      or railings going soft? See{" "}
      <a href="/wood-rot-repair/">wood rot repair</a>.
    </Paragraph>
  </Section>

  <!-- FAQ -->
  <Section class="section-alt">
    <ContentWrapper variant="sticky-content">
      <Heading tag="h2" maxWidth={14}>Pergola Questions</Heading>
      <Paragraph maxWidth={30}>
        Something else? <a href="/contact/">Get in touch</a>.
      </Paragraph>
      <Accordion slot="column2" single>
        {visibleFaqs(faqs).map((faq) => (
          <AccordionItem heading={faq.question}>
            <Paragraph set:html={faq.answer} />
          </AccordionItem>
        ))}
      </Accordion>
    </ContentWrapper>
  </Section>

  <RelatedServices current="/pergolas/" />
</Layout>
